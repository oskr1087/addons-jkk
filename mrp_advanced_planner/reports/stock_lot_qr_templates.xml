<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_stock_lot_qr_pda">
        <t t-call="web.html_container">
            <style>
                @page {
                    size: A4 portrait;
                    margin: 5mm;
                }
                .aps-lot-sheet {
                    width: 200mm;
                    height: 287mm;
                    margin: 0;
                    padding: 0;
                    page-break-after: always;
                    font-family: Arial, Helvetica, sans-serif;
                }
                .aps-lot-sheet:last-child {
                    page-break-after: auto;
                }
                .aps-label-table {
                    width: 100%;
                    height: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .aps-label-cell {
                    width: 50%;
                    height: 25%;
                    padding: 2mm;
                    vertical-align: top;
                }
                .aps-label {
                    height: 65mm;
                    border: 0.35mm solid #222;
                    border-radius: 2mm;
                    padding: 3mm;
                    box-sizing: border-box;
                    overflow: hidden;
                }
                .aps-inner {
                    width: 100%;
                    height: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .aps-qr-col {
                    width: 36%;
                    text-align: center;
                    vertical-align: middle;
                    padding-right: 2mm;
                }
                .aps-data-col {
                    width: 64%;
                    vertical-align: middle;
                }
                .aps-qr {
                    width: 30mm;
                    height: 30mm;
                }
                .aps-title {
                    font-size: 9pt;
                    font-weight: bold;
                    text-align: center;
                    border-bottom: 0.35mm solid #222;
                    padding-bottom: 1mm;
                    margin-bottom: 1.5mm;
                    text-transform: uppercase;
                }
                .aps-lot-name {
                    font-size: 14pt;
                    font-weight: bold;
                    line-height: 1.05;
                    margin: 1.5mm 0 2mm 0;
                    word-break: break-all;
                }
                .aps-product {
                    font-size: 7.5pt;
                    font-weight: 600;
                    line-height: 1.15;
                    max-height: 12mm;
                    overflow: hidden;
                    margin-bottom: 1.5mm;
                }
                .aps-meta {
                    font-size: 7pt;
                    line-height: 1.3;
                }
                .aps-scan {
                    font-size: 7pt;
                    font-weight: bold;
                    text-align: center;
                    margin-top: 2mm;
                }
                .aps-empty {
                    border: 0.25mm dashed #bbb;
                }
            </style>

            <t t-foreach="range(0, len(docs), 8)" t-as="page_start">
                <div class="aps-lot-sheet">
                    <table class="aps-label-table">
                        <tbody>
                            <t t-foreach="range(0, 8, 2)" t-as="row_start">
                                <tr>
                                    <t t-foreach="[0, 1]" t-as="col_offset">
                                        <t t-set="doc_index"
                                           t-value="page_start + row_start + col_offset"/>
                                        <td class="aps-label-cell">
                                            <t t-if="doc_index &lt; len(docs)">
                                                <t t-set="lot" t-value="docs[doc_index]"/>
                                                <div class="aps-label">
                                                    <table class="aps-inner">
                                                        <tbody>
                                                            <tr>
                                                                <td class="aps-qr-col">
                                                                    <span t-field="lot.aps_pda_qr_value"
                                                                          t-options="{
                                                                              'widget': 'barcode',
                                                                              'symbology': 'QR',
                                                                              'width': 220,
                                                                              'height': 220,
                                                                              'quiet': 1,
                                                                              'img_style': 'width:30mm;height:30mm;'
                                                                          }"/>
                                                                    <div class="aps-scan">
                                                                        Escanear con PDA
                                                                    </div>
                                                                </td>
                                                                <td class="aps-data-col">
                                                                    <div class="aps-title">
                                                                        Lote / Serie
                                                                    </div>
                                                                    <div class="aps-lot-name">
                                                                        <span t-esc="lot.name"/>
                                                                    </div>
                                                                    <div class="aps-product">
                                                                        <span t-esc="lot.product_id.display_name"/>
                                                                    </div>
                                                                    <div class="aps-meta">
                                                                        <div>
                                                                            <strong>Código:</strong>
                                                                            <span t-esc="lot.product_id.default_code or '-'"/>
                                                                        </div>
                                                                        <div>
                                                                            <strong>Cantidad:</strong>
                                                                            <span t-esc="'%.2f' % lot._aps_pda_qty()"/>
                                                                            <span t-esc="lot.product_id.uom_id.name"/>
                                                                        </div>
                                                                        <div>
                                                                            <strong>QR:</strong>
                                                                            <span t-esc="lot._aps_pda_qr_payload()"/>
                                                                        </div>
                                                                        <div t-if="'expiration_date' in lot._fields and lot.expiration_date">
                                                                            <strong>Caducidad:</strong>
                                                                            <span t-field="lot.expiration_date"
                                                                                  t-options="{'widget': 'date'}"/>
                                                                        </div>
                                                                        <div t-if="'use_date' in lot._fields and lot.use_date">
                                                                            <strong>Uso preferente:</strong>
                                                                            <span t-field="lot.use_date"
                                                                                  t-options="{'widget': 'date'}"/>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="aps-label aps-empty"/>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
