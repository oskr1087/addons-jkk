<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_advanced_planner.PlanningStockTooltipField">
        <span class="o_planning_stock_widget"
              t-on-mouseenter="showPopover"
              t-on-mouseleave="hidePopover">
            <span class="o_planning_stock_value">
                <t t-esc="value"/>
            </span>
            <i class="fa fa-area-chart o_planning_stock_icon"
               title="Ver disponibilidad por almacén"/>

            <t t-if="state.visible">
                <div class="o_planning_stock_popover"
                     t-att-style="popoverStyle"
                     role="tooltip">
                    <div class="o_planning_stock_popover_arrow"/>
                    <div class="o_planning_stock_popover_header">
                        <div>
                            <div class="o_planning_stock_popover_title">Pronóstico disponible</div>
                            <div class="o_planning_stock_popover_subtitle">Pronóstico por almacén</div>
                        </div>
                        <div class="o_planning_stock_total">
                            <span>Total</span>
                            <strong><t t-esc="value"/></strong>
                        </div>
                    </div>

                    <div class="o_planning_stock_popover_body">
                        <div class="o_planning_forecast_formula">
                            <div class="o_planning_forecast_metric">
                                <strong t-esc="totals.onHand"/>
                                <span>A la mano</span>
                            </div>
                            <div class="o_planning_forecast_operator">+</div>
                            <div class="o_planning_forecast_metric">
                                <strong t-esc="totals.incoming"/>
                                <span>Entrante</span>
                            </div>
                            <div class="o_planning_forecast_operator">−</div>
                            <div class="o_planning_forecast_metric">
                                <strong t-esc="totals.outgoing"/>
                                <span>Saliente</span>
                            </div>
                            <div class="o_planning_forecast_operator">=</div>
                            <div class="o_planning_forecast_metric o_planning_forecast_result">
                                <strong><t t-esc="totals.forecast"/></strong>
                                <span>Pronosticado</span>
                            </div>
                        </div>

                        <t t-if="totals.hasAdjustments">
                            <div class="o_planning_forecast_adjustments">
                                <span t-if="totals.rfq != 0">RFQ pendientes: <strong t-esc="totals.rfq"/></span>
                                <span t-if="totals.otherPlan != 0">Otros planes: <strong t-esc="totals.otherPlan"/></span>
                                <span t-if="totals.hasOpenMo">OF confirmadas/en proceso: <strong t-esc="totals.openMo"/></span>
                            </div>
                        </t>

                        <div class="o_planning_stock_section_title">Detalle por almacén</div>
                        <t t-if="warehouseRows.length">
                            <t t-foreach="warehouseRows" t-as="row" t-key="row.warehouse">
                                <div class="o_planning_stock_warehouse_detail">
                                    <div class="o_planning_stock_warehouse_name">
                                        <i class="fa fa-building-o"/>
                                        <strong t-esc="row.warehouse"/>
                                    </div>
                                    <div class="o_planning_stock_warehouse_open_mo" t-if="row.openMo &gt; 0">
                                        <i class="fa fa-industry"/>
                                        <span>Fabricando / OF abiertas: <strong t-esc="formatQty(row.openMo)"/></span>
                                    </div>
                                    <div class="o_planning_stock_warehouse_formula">
                                        <span><small>A mano</small><b t-esc="formatQty(row.onHand)"/></span>
                                        <i>+</i>
                                        <span><small>Entrante</small><b t-esc="formatQty(row.incoming)"/></span>
                                        <i>−</i>
                                        <span><small>Saliente</small><b t-esc="formatQty(row.outgoing)"/></span>
                                        <i>=</i>
                                        <span class="o_planning_stock_warehouse_result"><small>Pronóstico</small><b t-esc="formatQty(row.forecast)"/></span>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="o_planning_stock_empty">Sin detalle de almacenes</div>
                        </t>
                    </div>

                    <div class="o_planning_stock_popover_footer">
                        <i class="fa fa-info-circle"/>
                        <span>Pronóstico al horizonte de esta planificación</span>
                    </div>
                </div>
            </t>
        </span>
    </t>
</templates>
