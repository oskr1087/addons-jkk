<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="mrp_advanced_planner.PlanningDashboard">
<div class="o_mrp_advanced_dashboard p-3 p-lg-4">
    <t t-if="state.loading"><div class="d-flex justify-content-center py-5"><i class="fa fa-spinner fa-spin fa-2x"/></div></t>
    <t t-else="">
        <div class="card aps-hero mb-4"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div><div class="small text-uppercase aps-muted fw-bold">Control de planificación</div><h2 class="mb-1">Panel de abastecimiento y fabricación</h2><div class="aps-muted" t-if="state.data.plan"><i class="fa fa-calendar me-1"/><t t-esc="state.data.plan.name"/> · Hasta <t t-esc="state.data.plan.date_end"/> · <t t-esc="state.data.plan.warehouses"/></div></div>
            <div class="d-flex gap-2"><select class="form-select" t-on-change="onPlanChange.bind(this)"><option value="">Último plan calculado</option><t t-foreach="state.data.plans" t-as="p" t-key="p.id"><option t-att-value="p.id" t-att-selected="state.data.plan &amp;&amp; state.data.plan.id === p.id"><t t-esc="p.name"/></option></t></select><button class="btn btn-light border" t-on-click="loadData.bind(this)"><i class="fa fa-refresh"/> Actualizar</button><button class="btn btn-primary" t-on-click="openPlan.bind(this)" t-if="state.data.plan">Abrir plan</button></div>
        </div></div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-demand h-100"><div class="card-body"><div class="small aps-muted text-uppercase">Demanda</div><div class="aps-big-number"><t t-esc="state.data.kpis.pending_sales_qty || 0"/></div><div class="small aps-muted"><t t-esc="state.data.kpis.products || 0"/> productos</div></div></div></div>
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-stock h-100"><div class="card-body"><div class="small aps-muted text-uppercase">Stock disponible</div><div class="aps-big-number"><t t-esc="state.data.kpis.stock_qty || 0"/></div></div></div></div>
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-running h-100"><div class="card-body"><div class="small aps-muted text-uppercase">OF abiertas</div><div class="aps-big-number"><t t-esc="state.data.kpis.manufacturing_qty || 0"/></div></div></div></div>
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-running h-100"><div class="card-body"><div class="small aps-muted text-uppercase">A fabricar</div><div class="aps-big-number"><t t-esc="state.data.kpis.to_manufacture_qty || 0"/></div></div></div></div>
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-demand h-100"><div class="card-body"><div class="small aps-muted text-uppercase">A comprar</div><div class="aps-big-number"><t t-esc="state.data.kpis.to_purchase_qty || 0"/></div></div></div></div>
            <div class="col-6 col-xl-2"><div class="card aps-kpi aps-kpi-stock h-100"><div class="card-body"><div class="small aps-muted text-uppercase">A mover</div><div class="aps-big-number"><t t-esc="state.data.kpis.to_move_qty || 0"/></div></div></div></div>
        </div>

        <div class="card aps-panel mb-4"><div class="card-header d-flex justify-content-between align-items-center"><div><strong>Planificación por producto</strong><div class="small aps-muted">Productos agrupados; una sola decisión por producto</div></div><span class="aps-badge"><t t-esc="state.data.forecast_products.length"/> productos</span></div>
            <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Producto</th><th>Entrega</th><th class="text-end">Pedidos</th><th class="text-end">Demanda</th><th class="text-end">Stock</th><th class="text-end">OF</th><th class="text-end">Necesidad</th><th>Acción</th><th class="text-end">Cantidad</th><th>Destino</th></tr></thead><tbody>
                <t t-if="!state.data.forecast_products.length"><tr><td colspan="10" class="text-center aps-muted py-4">Sin productos pendientes.</td></tr></t>
                <t t-foreach="state.data.forecast_products" t-as="line" t-key="line.id"><tr class="aps-product-row" t-on-click="() => this.openForecastLine(line.id)"><td><strong><t t-esc="line.product"/></strong><div class="small aps-muted"><t t-esc="line.sale_lines"/> líneas de venta</div></td><td><t t-esc="line.delivery_date"/></td><td class="text-end"><t t-esc="line.orders"/></td><td class="text-end"><t t-esc="line.sales_qty"/></td><td class="text-end"><t t-esc="line.stock_qty"/></td><td class="text-end"><t t-esc="line.manufacturing_qty"/></td><td class="text-end"><t t-esc="line.suggested_qty"/></td><td><span t-att-class="'aps-status-pill '+actionClass(line.action)"><span class="aps-dot"/><t t-esc="line.action_label"/></span></td><td class="text-end fw-bold"><t t-esc="line.planner_qty"/></td><td><t t-esc="line.warehouse"/></td></tr></t>
            </tbody></table></div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-4"><div class="card aps-panel h-100"><div class="card-header d-flex justify-content-between"><strong>Órdenes de fabricación</strong><button class="btn btn-sm btn-light border" t-on-click="() => this.openMOs(false)">Ver todas (<t t-esc="state.data.kpis.mo_count || 0"/>)</button></div><div class="card-body"><t t-if="!state.data.states.length"><div class="aps-muted">No se generaron OF.</div></t><t t-foreach="state.data.states" t-as="s" t-key="s.key"><div class="aps-state-row" t-on-click="() => this.openMOs(s.key)"><div class="d-flex justify-content-between"><strong><t t-esc="s.label"/></strong><span t-att-class="'aps-status-pill '+moClass(s.key)"><span class="aps-dot"/><t t-esc="s.count"/></span></div><div class="small aps-muted">Pendiente <t t-esc="s.remaining_qty"/></div><div class="aps-progress mt-2"><div t-att-class="moClass(s.key)" t-att-style="'width:'+statePercent(s)+'%'"/></div></div></t></div></div></div>
            <div class="col-12 col-xl-4"><div class="card aps-panel h-100"><div class="card-header d-flex justify-content-between"><strong>Compras generadas</strong><button class="btn btn-sm btn-light border" t-on-click="openPOs.bind(this)">Ver (<t t-esc="state.data.kpis.po_count || 0"/>)</button></div><div class="card-body"><t t-if="!state.data.purchase_orders.length"><div class="aps-muted">Sin solicitudes de cotización.</div></t><t t-foreach="state.data.purchase_orders" t-as="po" t-key="po.id"><div class="border-bottom py-2 d-flex justify-content-between"><div><strong><t t-esc="po.name"/></strong><div class="small aps-muted"><t t-esc="po.vendor"/></div></div><div class="text-end"><span class="aps-status-pill aps-sem-yellow"><span class="aps-dot"/><t t-esc="po.state_label"/></span><div class="small mt-1"><t t-esc="po.amount_total"/> <t t-esc="po.currency"/></div></div></div></t></div></div></div>
            <div class="col-12 col-xl-4"><div class="card aps-panel h-100"><div class="card-header d-flex justify-content-between"><strong>Reabastecimientos</strong><button class="btn btn-sm btn-light border" t-on-click="openTransfers.bind(this)">Ver (<t t-esc="state.data.kpis.transfer_count || 0"/>)</button></div><div class="card-body"><t t-if="!state.data.transfers.length"><div class="aps-muted">Sin transferencias internas.</div></t><t t-foreach="state.data.transfers" t-as="p" t-key="p.id"><div class="border-bottom py-2"><div class="d-flex justify-content-between"><strong><t t-esc="p.name"/></strong><span class="aps-status-pill aps-sem-green"><span class="aps-dot"/><t t-esc="p.state_label"/></span></div><div class="small aps-muted"><t t-esc="p.source"/> → <t t-esc="p.destination"/></div></div></t></div></div></div>
        </div>

        <div class="card aps-panel mb-4"><div class="card-header d-flex justify-content-between"><div><strong>Centros de trabajo del plan</strong><div class="small aps-muted">Solo operaciones de OF creadas por esta planificación</div></div><button class="btn btn-sm btn-light border" t-on-click="() => this.openWorkorders(false)">Órdenes de trabajo</button></div><div class="card-body"><div class="row g-3"><div t-if="!state.data.workcenters.length" class="col-12 text-center aps-muted py-3">Todavía no hay centros de trabajo asociados.</div><t t-foreach="state.data.workcenters" t-as="wc" t-key="wc.id"><div class="col-12 col-lg-6 col-xxl-4"><div t-att-class="'border rounded-3 p-3 h-100 aps-workcenter '+(wc.running_count ? 'aps-sem-blue' : wc.queue_count ? 'aps-sem-yellow' : 'aps-sem-green')"><div class="d-flex justify-content-between"><strong><t t-esc="wc.name"/></strong><span class="aps-badge"><t t-esc="wc.running_count"/> curso · <t t-esc="wc.queue_count"/> cola</span></div><t t-if="wc.current_mo"><div class="aps-current-production p-3 rounded mt-3"><div class="small aps-muted text-uppercase">Fabricando ahora</div><div class="fw-bold"><t t-esc="wc.current_product"/></div><div class="small"><t t-esc="wc.current_mo"/> · <t t-esc="wc.current_operation"/></div><div class="aps-progress mt-2"><div t-att-class="progressClass(wc.current_progress)" t-att-style="progressStyle(wc.current_progress)"/></div></div></t><button class="btn btn-sm btn-link px-0 mt-2" t-on-click="() => this.openWorkorders(wc.id)">Ver cola</button></div></div></t></div></div></div>

        <div class="row g-3"><div class="col-12"><div class="card aps-panel"><div class="card-header"><strong>Alertas</strong></div><div class="card-body d-flex flex-wrap gap-2"><div class="aps-alert aps-alert-danger p-3 flex-grow-1"><strong>OF atrasadas</strong><div class="aps-big-number"><t t-esc="state.data.alerts.late_mo_count || 0"/></div></div><div class="aps-alert aps-alert-warning p-3 flex-grow-1"><strong>Fabricar sin LdM</strong><div class="aps-big-number"><t t-esc="state.data.alerts.manufacture_without_bom || 0"/></div></div><div class="aps-alert aps-alert-warning p-3 flex-grow-1"><strong>Sin acción definida</strong><div class="aps-big-number"><t t-esc="state.data.alerts.undefined_action || 0"/></div></div></div></div></div></div>
    </t>
</div>
</t>
</templates>
