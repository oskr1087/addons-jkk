<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_planning_component_lot_reservation_list" model="ir.ui.view">
        <field name="name">mrp.planning.component.lot.reservation.list</field>
        <field name="model">mrp.planning.component.lot.reservation</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  create="1"
                  delete="1"
                  decoration-success="state in ('reserved', 'assigned')"
                  decoration-muted="state in ('released', 'consumed')">
                <field name="product_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="component_id" column_invisible="1"/>
                <field name="warehouse_id" readonly="1"/>
                <field name="lot_id"/>
                <field name="available_qty" readonly="1"/>
                <field name="reserved_qty"/>
                <field name="state" widget="badge" readonly="1"/>
                <field name="production_id" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_planning_component_lot_reservation_form" model="ir.ui.view">
        <field name="name">mrp.planning.component.lot.reservation.form</field>
        <field name="model">mrp.planning.component.lot.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva APS de lote">
                <sheet>
                    <group>
                        <group>
                            <field name="component_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="lot_id"/>
                            <field name="available_qty" readonly="1"/>
                            <field name="reserved_qty"/>
                            <field name="state" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="plan_id" invisible="1"/>
                    <field name="planning_line_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
