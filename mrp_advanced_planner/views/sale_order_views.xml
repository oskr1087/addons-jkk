<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_planning_delivery_line" model="ir.ui.view">
        <field name="name">sale.order.form.planning.delivery.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Visible directly in the normal sale order lines. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="planning_delivery_date"
                       string="Fecha entrega"
                       optional="show"
                       readonly="0"/>
                <field name="aps_stock_warehouse_tooltip" column_invisible="1"/>
                <field name="aps_forecast_qty" column_invisible="1"/>
                <field name="aps_open_mo_qty" column_invisible="1"/>
                <field name="aps_forecast_status"
                       string="Disponibilidad"
                       widget="planning_sale_availability"
                       readonly="1"
                       optional="show"/>
            </xpath>

            <!-- Also visible when opening a sale line form. -->
            <xpath expr="//field[@name='order_line']/form//field[@name='customer_lead']" position="after">
                <field name="planning_delivery_date" string="Fecha de entrega planificación" readonly="0"/>
                <field name="aps_stock_warehouse_tooltip" invisible="1"/>
                <field name="aps_forecast_qty" invisible="1"/>
                <field name="aps_open_mo_qty" invisible="1"/>
                <field name="aps_forecast_status"
                       string="Disponibilidad y abastecimiento"
                       widget="planning_sale_availability"
                       readonly="1"/>
            </xpath>

            <!-- Dedicated editor remains available even if the commercial order is locked. -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Planificación de entregas" name="planning_delivery_lines">
                    <div class="alert alert-info" role="alert">
                        La fecha de cada línea se toma inicialmente de la Fecha de entrega del pedido.
                        Puede cambiarse por producto y es la fecha que utiliza el planificador de fabricación.
                    </div>
                    <field name="order_line" nolabel="1" readonly="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="display_type" column_invisible="1"/>
                            <field name="product_id" string="Producto" readonly="1"/>
                            <field name="product_uom_qty" string="Pedido" readonly="1"/>
                            <field name="qty_delivered" string="Entregado" readonly="1"/>
                            <field name="planning_delivery_date"
                                   string="Fecha de entrega"
                                   readonly="0"
                                   invisible="display_type"/>
                            <button name="action_reset_planning_delivery_date"
                                    type="object"
                                    icon="fa-undo"
                                    title="Restablecer fecha del pedido"
                                    invisible="display_type"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
