<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_proposal_tree" model="ir.ui.view">
        <field name="name">mrp.planning.production.proposal.tree</field>
        <field name="model">mrp.planning.production.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="date_required"/>
                <field name="state"/>
                <field name="production_id"/>
            </list>
        </field>
    </record>
    <record id="view_purchase_proposal_tree" model="ir.ui.view">
        <field name="name">mrp.planning.purchase.proposal.tree</field>
        <field name="model">mrp.planning.purchase.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="quantity"/>
                <field name="date_planned"/>
                <field name="state"/>
                <field name="purchase_order_id"/>
            </list>
        </field>
    </record>
    <record id="action_production_proposals" model="ir.actions.act_window">
        <field name="name">Propuestas de fabricación</field>
        <field name="res_model">mrp.planning.production.proposal</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_purchase_proposals" model="ir.actions.act_window">
        <field name="name">Propuestas de compra</field>
        <field name="res_model">mrp.planning.purchase.proposal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
