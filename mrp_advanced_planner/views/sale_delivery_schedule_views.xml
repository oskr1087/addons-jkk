<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_aps_delivery_calendar" model="ir.ui.view">
        <field name="name">sale.order.line.aps.delivery.calendar</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <calendar js_class="aps_delivery_calendar" string="Entregas para planificación APS" date_start="planning_delivery_date" color="aps_planning_status" mode="month" create="0" quick_create="0">
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="aps_planning_status"/>
                <field name="aps_plan_count"/>
                <field name="aps_plan_ids"/>
            </calendar>
        </field>
    </record>

    <record id="view_sale_order_line_aps_delivery_list" model="ir.ui.view">
        <field name="name">sale.order.line.aps.delivery.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Entregas para planificación APS" create="0" edit="0" delete="0" decoration-success="aps_plan_count &gt; 0" decoration-warning="aps_plan_count == 0">
                <field name="planning_delivery_date" string="Fecha entrega"/>
                <field name="order_id" string="Pedido"/>
                <field name="order_partner_id" string="Cliente"/>
                <field name="product_id" string="Producto"/>
                <field name="product_uom_qty" string="Cantidad"/>
                <field name="qty_delivered" string="Entregado"/>
                <field name="product_uom_id" string="UdM"/>
                <field name="aps_planning_status"
                       string="Estado APS"
                       widget="badge"
                       decoration-warning="aps_planning_status == 'pending'"
                       decoration-success="aps_planning_status == 'planned'"/>
                <field name="aps_plan_count" string="Planes APS"/>
                <field name="aps_plan_ids" string="Planificación APS" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_aps_delivery_search" model="ir.ui.view">
        <field name="name">sale.order.line.aps.delivery.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Entregas para planificación APS">
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="product_id"/>
                <field name="planning_delivery_date"/>
                <field name="aps_planning_status"/>
                <filter name="pending_aps"
                        string="Sin planificación"
                        domain="[('aps_planning_status', '=', 'pending')]"/>
                <filter name="planned_aps"
                        string="Dentro de planificación"
                        domain="[('aps_planning_status', '=', 'planned')]"/>
                <filter name="all_aps"
                        string="Todas"
                        domain="[]"/>
                <separator/>
                <filter name="group_delivery_date" string="Fecha de entrega" context="{'group_by': 'planning_delivery_date:day'}"/>
                <filter name="group_order" string="Pedido" context="{'group_by': 'order_id'}"/>
                <filter name="group_customer" string="Cliente" context="{'group_by': 'order_partner_id'}"/>
                <filter name="group_status"
                        string="Estado APS"
                        context="{'group_by': 'aps_planning_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_sale_order_line_aps_delivery_schedule" model="ir.actions.act_window">
        <field name="name">Entregas para planificación</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">calendar,list</field>
        <field name="views" eval="[(ref('view_sale_order_line_aps_delivery_calendar'), 'calendar'), (ref('view_sale_order_line_aps_delivery_list'), 'list')]"/>
        <field name="search_view_id" ref="view_sale_order_line_aps_delivery_search"/>
        <field name="domain">[('order_id.state', '=', 'sale'), ('display_type', '=', False), ('product_id', '!=', False), ('product_uom_qty', '&gt;', 0), ('planning_delivery_date', '!=', False)]</field>
        <field name="context">{}</field>
    </record>

    <!-- Menú explícito para asegurar visibilidad en Ventas / Órdenes -->
    <record id="menu_sale_aps_delivery_schedule" model="ir.ui.menu">
        <field name="name">Entregas para planificación</field>
        <field name="parent_id" ref="sale.sale_order_menu"/>
        <field name="action" ref="action_sale_order_line_aps_delivery_schedule"/>
        <field name="sequence">25</field>
        <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
