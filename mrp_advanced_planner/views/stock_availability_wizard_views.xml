<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_planning_stock_availability_wizard_form" model="ir.ui.view">
        <field name="name">mrp.planning.stock.availability.wizard.form</field>
        <field name="model">mrp.planning.stock.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="Disponibilidad por bodega" class="o_aps_availability_wizard">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="product_id" readonly="1"/></h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="text-muted small text-uppercase">Necesidad total</div>
                                    <h3><field name="required_qty" nolabel="1"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="card h-100 border-success">
                                <div class="card-body">
                                    <div class="text-muted small text-uppercase">Disponible total</div>
                                    <h3><field name="total_available_qty" nolabel="1"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="card h-100 border-danger">
                                <div class="card-body">
                                    <div class="text-muted small text-uppercase">Necesidad neta</div>
                                    <h3><field name="net_need_qty" nolabel="1"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="text-muted small text-uppercase">Estado</div>
                                    <field name="availability_status"
                                           widget="badge"
                                           decoration-success="availability_status == 'sufficient'"
                                           decoration-warning="availability_status == 'partial'"
                                           decoration-danger="availability_status == 'none'"
                                           nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" edit="0"
                              decoration-success="availability_status == 'sufficient'"
                              decoration-warning="availability_status == 'partial'"
                              decoration-danger="availability_status == 'none'">
                            <field name="warehouse_id"/>
                            <field name="on_hand_qty" sum="A mano"/>
                            <field name="reserved_qty" sum="Reservado"/>
                            <field name="available_qty" sum="Disponible"/>
                            <field name="confirmed_po_qty" string="PO en tránsito" sum="PO en tránsito"/>
                            <field name="available_with_incoming_qty" string="Total disponible" sum="Total disponible"/>
                            <field name="availability_status"
                                   widget="badge"
                                   decoration-success="availability_status == 'sufficient'"
                                   decoration-warning="availability_status == 'partial'"
                                   decoration-danger="availability_status == 'none'"/>
                        </list>
                    </field>

                    <div class="alert alert-info mt-3" role="alert">
                        <strong>Semáforo:</strong>
                        Verde = disponible suficiente ·
                        Amarillo = cobertura parcial ·
                        Rojo = sin disponibilidad suficiente.
                        Las PO consideradas son únicamente órdenes confirmadas pendientes de recibir dentro del horizonte de la planificación.
                    </div>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
