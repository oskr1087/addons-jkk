<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_planning_calendar_day_wizard_form" model="ir.ui.view">
        <field name="name">mrp.planning.calendar.day.wizard.form</field>
        <field name="model">mrp.planning.calendar.day.wizard</field>
        <field name="arch" type="xml">
            <form string="Planificar entregas del día">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Se incluirán las líneas de venta confirmadas, pendientes de entrega y todavía no incluidas en una planificación APS, cuya Fecha de entrega sea el día seleccionado o una fecha anterior.
                    </div>
                    <group>
                        <field name="planning_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="pending_line_count" readonly="1"/>
                    </group>
                    <group string="Líneas pendientes hasta la fecha seleccionada"
                           invisible="pending_line_count == 0">
                        <field name="pending_sale_line_ids"
                               nolabel="1"
                               readonly="1">
                            <list create="0" delete="0">
                                <field name="planning_delivery_date" string="Fecha entrega"/>
                                <field name="order_id" string="Pedido"/>
                                <field name="product_id" string="Producto"/>
                                <field name="product_uom_qty" string="Cantidad"/>
                                <field name="qty_delivered" string="Entregado"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_plan"
                            string="Planificar este día"
                            type="object"
                            class="btn-primary"
                            invisible="pending_line_count == 0"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_planning_calendar_day_wizard" model="ir.actions.act_window">
        <field name="name">Planificar un día</field>
        <field name="res_model">mrp.planning.calendar.day.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_planning_calendar_day_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>


</odoo>
