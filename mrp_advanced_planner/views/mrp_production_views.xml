<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_planning_origin" model="ir.ui.view">
        <field name="name">mrp.production.form.planning.origin</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_component_purchases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="component_purchase_count == 0">
                    <field name="component_purchase_count" widget="statinfo" string="Compras componentes"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_list_planning_origin" model="ir.ui.view">
        <field name="name">mrp.production.list.planning.origin</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="advanced_plan_id" string="Planificación" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
