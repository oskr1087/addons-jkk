<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_planning_production_component_form" model="ir.ui.view">
        <field name="name">mrp.planning.production.component.form</field>
        <field name="model">mrp.planning.production.component</field>
        <field name="arch" type="xml">
            <form string="Componente APS"
                  class="o_aps_component_editor">
                <sheet>
                    <!-- CONTEXTO -->
                    <div class="o_aps_component_editor_header">
                        <div>
                            <div class="o_aps_component_eyebrow">
                                INGENIERÍA DE FABRICACIÓN APS
                            </div>
                            <h2 class="mb-1">
                                <field name="root_product_display_id"
                                       readonly="1"
                                       options="{'no_open': True}"/>
                            </h2>
                            <div class="text-muted">
                                <span invisible="not parent_product_id">
                                    Subcomponente de
                                    <field name="parent_product_id"
                                           readonly="1"
                                           options="{'no_open': True}"/>
                                </span>
                                <span class="ms-2">
                                    Nivel <field name="level" readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <div class="o_aps_component_status">
                            <field name="availability_status"
                                   widget="badge"
                                   readonly="1"
                                   decoration-muted="availability_status == 'pending'"
                                   decoration-success="availability_status == 'sufficient'"
                                   decoration-warning="availability_status == 'partial'"
                                   decoration-danger="availability_status == 'none'"/>
                            <field name="supply_resolution"
                                   widget="badge"
                                   readonly="1"
                                   invisible="availability_status == 'pending'"/>
                        </div>
                    </div>

                    <div class="alert alert-info mt-2"
                         role="alert"
                         invisible="not engineering_locked">
                        <i class="fa fa-lock me-2" title="Bloqueado"/>
                        La ingeniería está bloqueada porque ya se generó la
                        Orden de Fabricación. Puede consultar el componente,
                        pero no modificarlo.
                    </div>

                    <!-- EDICIÓN PRINCIPAL -->
                    <div class="o_aps_component_primary">
                        <div class="o_aps_component_section_title">
                            COMPONENTE A UTILIZAR
                        </div>
                        <group col="4">
                            <field name="product_id"
                                   string="Componente"
                                   required="1"
                                   options="{'no_create_edit': False}"
                                   readonly="engineering_locked"/>
                            <field name="planned_qty"
                                   string="Cantidad"
                                   required="1"
                                   readonly="engineering_locked"/>
                            <field name="product_uom_id"
                                   string="UdM"
                                   required="1"
                                   readonly="engineering_locked"/>
                            <field name="include_in_mo"
                                   string="Incluir en OF"
                                   readonly="engineering_locked"/>
                        </group>
                        <field name="note"
                               string="Observación"
                               placeholder="Motivo del cambio, sustitución o nota para producción..."
                               readonly="engineering_locked"/>
                    </div>

                    <!-- DISPONIBILIDAD -->
                    <div class="o_aps_component_section_title mt-3">
                        DISPONIBILIDAD Y RESOLUCIÓN
                    </div>
                    <div class="o_aps_component_kpis">
                        <div class="o_aps_component_kpi">
                            <span>Disponible local</span>
                            <strong><field name="local_supply_qty" readonly="1"/></strong>
                        </div>
                        <div class="o_aps_component_kpi">
                            <span>Otras bodegas</span>
                            <strong><field name="external_move_suggested_qty" readonly="1"/></strong>
                        </div>
                        <div class="o_aps_component_kpi">
                            <span>Necesidad</span>
                            <strong><field name="effective_required_qty" readonly="1"/></strong>
                        </div>
                        <div class="o_aps_component_kpi o_aps_component_kpi_need">
                            <span>Faltante</span>
                            <strong><field name="availability_need_qty" readonly="1"/></strong>
                        </div>
                    </div>

                    <div class="o_aps_component_supply_summary"
                         invisible="availability_status == 'pending'">
                        <div>
                            <i class="fa fa-industry me-1" title="Fabricar"/>
                            A fabricar:
                            <strong><field name="to_manufacture_qty" readonly="1"/></strong>
                        </div>
                        <div>
                            <i class="fa fa-shopping-cart me-1" title="Comprar"/>
                            A comprar:
                            <strong><field name="to_purchase_qty" readonly="1"/></strong>
                        </div>
                        <div invisible="not is_subcontracted">
                            <i class="fa fa-handshake-o me-1" title="Subcontratación"/>
                            <strong>Subcontratación</strong>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-2">
                        <button name="action_open_availability"
                                type="object"
                                string="Ver disponibilidad por bodegas"
                                icon="fa-cubes"
                                class="btn-secondary"
                                invisible="not product_id"/>
                        <button name="action_open_lot_reservations"
                                type="object"
                                string="Lotes reservados"
                                icon="fa-tags"
                                class="btn-secondary ms-2"
                                invisible="product_tracking == 'none'"/>
                    </div>

                    <!-- TRAZABILIDAD SECUNDARIA -->
                    <notebook class="mt-3">
                        <page string="Lotes reservados"
                              name="lot_reservations"
                              invisible="product_tracking == 'none'">
                            <div class="alert alert-info"
                                 role="alert">
                                <i class="fa fa-info-circle me-2" title="Información"/>
                                APS carga por defecto los lotes disponibles hasta
                                cubrir la necesidad. Puede cambiar esta selección
                                mientras la OF todavía no haya sido generada.
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col">
                                    <strong>Reservado:</strong>
                                    <field name="reserved_lot_qty" readonly="1"/>
                                </div>
                                <div class="col">
                                    <strong>Pendiente:</strong>
                                    <field name="pending_lot_qty" readonly="1"/>
                                </div>
                                <div class="col">
                                    <strong>Cobertura:</strong>
                                    <field name="lot_coverage_percent"
                                           widget="percentage"
                                           readonly="1"/>
                                </div>
                                <div class="col">
                                    <field name="lot_reservation_status"
                                           widget="badge"
                                           readonly="1"/>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mb-2">
                                <button name="action_complete_lot_reservations"
                                        type="object"
                                        string="Completar reserva con lotes disponibles"
                                        icon="fa-refresh"
                                        class="btn-secondary"
                                        invisible="pending_lot_qty &lt;= 0"/>
                            </div>
                            <field name="lot_reservation_ids"
                                   nolabel="1"
                                   readonly="engineering_locked">
                                <list editable="bottom"
                                      create="1"
                                      delete="1">
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="warehouse_id" readonly="1"/>
                                    <field name="lot_id"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="reserved_qty"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Trazabilidad de ingeniería"
                              name="engineering_traceability">
                            <group>
                                <group>
                                    <field name="original_product_id"
                                           string="Componente ingeniería"
                                           readonly="1"
                                           options="{'no_open': True}"/>
                                    <field name="original_qty"
                                           string="Cantidad ingeniería"
                                           readonly="1"/>
                                    <field name="change_type"
                                           string="Tipo de cambio"
                                           widget="badge"
                                           readonly="1"/>
                                </group>
                                <group>
                                    <field name="source_bom_id"
                                           string="LdM origen"
                                           readonly="1"/>
                                    <field name="source_bom_line_id"
                                           string="Línea LdM origen"
                                           readonly="1"/>
                                    <field name="subcontract_bom_id"
                                           string="LdM subcontratación"
                                           readonly="1"
                                           invisible="not is_subcontracted"/>
                                </group>
                            </group>
                            <field name="path"
                                   string="Ruta de ingeniería"
                                   readonly="1"/>
                        </page>
                    </notebook>

                    <!-- CAMPOS TÉCNICOS -->
                    <field name="plan_id" invisible="1"/>
                    <field name="planning_line_id" invisible="1"/>
                    <field name="parent_line_id" invisible="1"/>
                    <field name="root_product_id" invisible="1"/>
                    <field name="availability_qty" invisible="1"/>
                    <field name="is_subcontracted" invisible="1"/>
                    <field name="engineering_locked" invisible="1"/>
                    <field name="product_tracking" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Guardar"
                            special="save"
                            class="btn-primary"
                            invisible="engineering_locked"/>
                    <button string="Descartar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
