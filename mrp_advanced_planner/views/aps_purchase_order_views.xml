<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_aps_list" model="ir.ui.view">
        <field name="name">purchase.order.aps.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Compras APS"
                  create="0"
                  delete="0"
                  decoration-info="state in ('draft', 'sent')"
                  decoration-success="state == 'purchase'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_untaxed" sum="Subtotal" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_order_aps_form" model="ir.ui.view">
        <field name="name">purchase.order.aps.form</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <form string="Compra APS">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,sent,to approve,purchase,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_advanced_plan"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                invisible="not advanced_plan_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Planificación</span>
                                <span class="o_stat_value">APS</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_ref"/>
                            <field name="advanced_plan_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos">
                            <field name="order_line">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="date_planned"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información">
                            <group>
                                <field name="origin"/>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer">
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
