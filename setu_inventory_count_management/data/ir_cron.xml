<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="ir.cron" id="auto_create_inventory_count_with_planner_cron">
            <field name="name">Auto Create Inventory Count with Planner</field>
            <field name="model_id" ref="setu_inventory_count_management.model_setu_stock_inventory_count_planner"/>
            <field name="state">code</field>
            <field name="code">model.auto_create_inventory_count_record()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="False"/>
        </record>
    
        <record id="ir_cron_inventory_count_background_jobs" model="ir.cron">
            <field name="name">Conteos: procesar trabajos en segundo plano</field>
            <field name="model_id" ref="model_setu_inventory_count_background_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_inventory_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>

    </data>
</odoo>
