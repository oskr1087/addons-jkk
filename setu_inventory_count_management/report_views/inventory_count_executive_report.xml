<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_inventory_count_executive" model="report.paperformat">
        <field name="name">Informe Ejecutivo de Conteo</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">14</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_inventory_count_executive" model="ir.actions.report">
        <field name="name">Informe ejecutivo del conteo</field>
        <field name="model">setu.stock.inventory.count</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">setu_inventory_count_management.report_inventory_count_executive</field>
        <field name="report_file">setu_inventory_count_management.report_inventory_count_executive</field>
        <field name="paperformat_id" ref="setu_inventory_count_management.paperformat_inventory_count_executive"/>
        <field name="print_report_name">'Informe_Ejecutivo_%s' % (object.name or 'Conteo')</field>
    </record>

    <template id="report_inventory_count_executive">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._get_executive_report_data()"/>
                <!-- Se usa basic_layout para evitar que el encabezado corporativo externo
                     se superponga con la cabecera ejecutiva propia del acta. -->
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .ei-wrap {font-family: Arial, sans-serif; color:#172033; font-size:9px;}
                            .ei-head {width:100%; border-collapse:collapse; border-bottom:3px solid #714b67; margin-bottom:10px;}
                            .ei-head td {vertical-align:middle; padding:0 0 8px 0;}
                            .ei-brand {font-size:12px; font-weight:700; color:#714b67; letter-spacing:.4px;}
                            .ei-title {font-size:21px; line-height:23px; font-weight:700; color:#1f2a44;}
                            .ei-sub {font-size:9px; color:#667085; margin-top:3px;}
                            .ei-doc {font-size:14px; font-weight:700; color:#714b67; text-align:right;}
                            .ei-state {font-size:8px; color:#475467; text-align:right; margin-top:3px;}
                            .ei-meta {width:100%; border-collapse:collapse; margin-bottom:9px;}
                            .ei-meta td {width:33.33%; border:1px solid #e4e7ec; padding:5px 7px; vertical-align:top;}
                            .ei-label {font-size:7px; text-transform:uppercase; color:#667085; font-weight:700;}
                            .ei-value {font-size:9px; font-weight:600; color:#101828; margin-top:2px;}
                            .ei-result {border:1px solid #d0d5dd; border-left:4px solid #714b67; padding:7px 9px; margin:8px 0 10px;}
                            .ei-result-title {font-size:8px; color:#667085; text-transform:uppercase; font-weight:700;}
                            .ei-result-value {font-size:13px; font-weight:700; color:#1f2a44; margin-top:2px;}
                            .ei-kpis {width:100%; border-collapse:separate; border-spacing:4px; margin-left:-4px;}
                            .ei-kpi {border:1px solid #e4e7ec; padding:8px; min-height:52px;}
                            .ei-kpi-label {font-size:7px; text-transform:uppercase; color:#667085; font-weight:700;}
                            .ei-kpi-value {font-size:17px; font-weight:700; color:#101828; margin-top:3px;}
                            .ei-kpi-note {font-size:7px; color:#667085; margin-top:2px;}
                            .ei-section {font-size:11px; font-weight:700; color:#1f2a44; border-bottom:1px solid #d0d5dd; padding-bottom:4px; margin:12px 0 6px;}
                            .ei-money-neg {color:#b42318; font-weight:700;}
                            .ei-money-pos {color:#027a48; font-weight:700;}
                            .ei-trace {width:100%; border-collapse:separate; border-spacing:4px; margin-left:-4px;}
                            .ei-trace td {border:1px solid #e4e7ec; padding:7px; vertical-align:top;}
                            .ei-table {width:100%; border-collapse:collapse; font-size:7.6px;}
                            .ei-table thead {display:table-header-group;}
                            .ei-table th {background:#f2f4f7; color:#344054; font-weight:700; border:1px solid #d0d5dd; padding:5px 4px;}
                            .ei-table td {border:1px solid #eaecf0; padding:4px; vertical-align:middle;}
                            .ei-table .num {text-align:right; white-space:nowrap;}
                            .ei-badge {font-size:6.7px; font-weight:700; padding:2px 4px; white-space:nowrap;}
                            .ei-success {background:#ecfdf3; color:#027a48;}
                            .ei-danger {background:#fef3f2; color:#b42318;}
                            .ei-warning {background:#fffaeb; color:#b54708;}
                            .ei-muted {color:#667085;}
                            .ei-nobreak {page-break-inside:avoid;}
                            .ei-detail-title {font-size:16px; font-weight:700; color:#1f2a44; margin-bottom:2px;}
                            .ei-detail-sub {font-size:8px; color:#667085; margin-bottom:8px;}
                            .ei-pagebreak {page-break-before:always;}
                            .ei-footer {font-size:7px; color:#667085; border-top:1px solid #d0d5dd; margin-top:10px; padding-top:5px;}
                        </style>

                        <div class="ei-wrap">
                            <!-- CABECERA PROPIA: sin external_layout -->
                            <table class="ei-head">
                                <tr>
                                    <td style="width:18%;">
                                        <div class="ei-brand" t-esc="doc.company_id.name"/>
                                    </td>
                                    <td style="width:55%;">
                                        <div class="ei-title">Informe Ejecutivo de Conteo de Inventario</div>
                                        <div class="ei-sub">Acta final del conteo físico, diferencias e impacto económico</div>
                                    </td>
                                    <td style="width:27%;">
                                        <div class="ei-doc" t-esc="doc.name"/>
                                        <div class="ei-state">Estado: <strong t-esc="data['final_status_label']"/></div>
                                    </td>
                                </tr>
                            </table>

                            <table class="ei-meta">
                                <tr>
                                    <td><div class="ei-label">Compañía</div><div class="ei-value" t-esc="doc.company_id.display_name"/></td>
                                    <td><div class="ei-label">Almacén</div><div class="ei-value" t-esc="doc.warehouse_id.display_name"/></td>
                                    <td><div class="ei-label">Ubicación</div><div class="ei-value" t-esc="doc.location_id.complete_name or doc.location_id.display_name"/></td>
                                </tr>
                                <tr>
                                    <td><div class="ei-label">Fecha del conteo</div><div class="ei-value"><span t-field="doc.inventory_count_date"/></div></td>
                                    <td><div class="ei-label">Responsable / aprobador</div><div class="ei-value" t-esc="doc.approver_id.display_name or '-'"/></td>
                                    <td><div class="ei-label">Sesiones</div><div class="ei-value"><span t-esc="data['session_count']"/> sesión(es)</div></td>
                                </tr>
                            </table>

                            <div class="ei-result">
                                <div class="ei-result-title">Resultado final del conteo</div>
                                <div class="ei-result-value" t-esc="data['final_result_label']"/>
                                <div class="ei-muted" style="margin-top:2px;">
                                    <t t-if="data['adjustment']">
                                        Ajuste asociado: <strong t-esc="data['adjustment'].display_name"/>
                                    </t>
                                    <t t-else="">
                                        No se requirió generar un ajuste de inventario para cerrar este conteo.
                                    </t>
                                </div>
                            </div>

                            <table class="ei-kpis">
                                <tr>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Avance final</div><div class="ei-kpi-value" t-esc="data['progress_fmt']"/><div class="ei-kpi-note"><span t-esc="data['counted_positions']"/> de <span t-esc="data['expected_positions']"/> posiciones</div></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Productos revisados</div><div class="ei-kpi-value" t-esc="data['product_count']"/><div class="ei-kpi-note">Productos consolidados</div></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Coincidencias</div><div class="ei-kpi-value" t-esc="data['matched']"/><div class="ei-kpi-note"><span t-esc="data['resolution_rate_fmt']"/> de posiciones procesadas</div></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Posiciones con diferencia</div><div class="ei-kpi-value" t-esc="data['divergences']"/><div class="ei-kpi-note"><span t-esc="data['unexpected_count']"/> no previstas · <span t-esc="data['duplicate_count']"/> duplicadas</div></div></td>
                                </tr>
                            </table>

                            <div class="ei-section">Impacto económico final</div>
                            <table class="ei-kpis">
                                <tr>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Valor base</div><div class="ei-kpi-value" style="font-size:14px;" t-esc="data['expected_value_fmt']"/></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Faltantes</div><div class="ei-money-neg" style="font-size:14px; margin-top:4px;" t-esc="data['shortage_value_fmt']"/></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Sobrantes</div><div class="ei-money-pos" style="font-size:14px; margin-top:4px;" t-esc="data['surplus_value_fmt']"/></div></td>
                                    <td style="width:25%;"><div class="ei-kpi"><div class="ei-kpi-label">Impacto neto</div><div t-att-class="'ei-money-neg' if doc.net_adjustment_value &lt; 0 else 'ei-money-pos'" style="font-size:14px; margin-top:4px;" t-esc="data['net_adjustment_value_fmt']"/></div></td>
                                </tr>
                            </table>

                            <div class="ei-section">Cierre y trazabilidad</div>
                            <table class="ei-trace ei-nobreak">
                                <tr>
                                    <td style="width:40%;">
                                        <div class="ei-label">Participantes</div>
                                        <div class="ei-value">
                                            <t t-if="data['participants']"><span t-esc="', '.join(data['participants'].mapped('display_name'))"/></t>
                                            <t t-else="">Sin participantes registrados</t>
                                        </div>
                                    </td>
                                    <td style="width:18%;">
                                        <div class="ei-label">Reconteos</div>
                                        <div class="ei-value" t-esc="data['recount_count']"/>
                                    </td>
                                    <td style="width:42%;">
                                        <div class="ei-label">Cierre de inventario</div>
                                        <t t-if="data['adjustment']">
                                            <div class="ei-value" t-esc="data['adjustment'].display_name"/>
                                            <div class="ei-muted">Ajuste generado y asociado al conteo</div>
                                        </t>
                                        <t t-else="">
                                            <div class="ei-value">No requerido</div>
                                            <div class="ei-muted">Conteo cerrado sin ajuste de inventario</div>
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="data['shortages'] or data['surpluses']">
                                <div class="ei-section">Principales diferencias por impacto</div>
                                <table class="ei-table ei-nobreak">
                                    <thead>
                                        <tr>
                                            <th style="width:48%;">Producto</th>
                                            <th class="num">Esperado</th><th class="num">Físico</th><th class="num">Diferencia</th><th class="num">Impacto</th><th>Resultado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="(data['shortages'] + data['surpluses'])[:8]" t-as="row">
                                            <tr>
                                                <td><t t-if="row['code']"><strong>[<span t-esc="row['code']"/>] </strong></t><span t-esc="row['name']"/></td>
                                                <td class="num" t-esc="'{:,.2f}'.format(row['expected_qty'])"/>
                                                <td class="num" t-esc="'{:,.2f}'.format(row['counted_qty'])"/>
                                                <td class="num" t-esc="'{:+,.2f}'.format(row['difference_qty'])"/>
                                                <td class="num" t-esc="row['impact_value_fmt']"/>
                                                <td><span t-att-class="'ei-badge ei-' + row['result_class']" t-esc="row['result']"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <div class="ei-footer">
                                Informe emitido el <span t-esc="data['issued_at_fmt']"/>.
                                Los importes se basan en cantidades y costos congelados durante el conteo y representan el resultado histórico del proceso.
                            </div>

                            <!-- DETALLE SIEMPRE EN PÁGINA NUEVA -->
                            <div class="ei-pagebreak"/>
                            <div class="ei-detail-title">Detalle consolidado del conteo</div>
                            <div class="ei-detail-sub">
                                <strong t-esc="doc.name"/> ·
                                <span t-esc="doc.warehouse_id.display_name"/> ·
                                <span t-esc="doc.location_id.complete_name or doc.location_id.display_name"/>
                            </div>
                            <table class="ei-table">
                                <thead>
                                    <tr>
                                        <th style="width:34%;">Producto</th>
                                        <th class="num" style="width:6%;">Pos.</th>
                                        <th class="num" style="width:6%;">Lotes</th>
                                        <th class="num" style="width:11%;">Esperado</th>
                                        <th class="num" style="width:11%;">Físico</th>
                                        <th class="num" style="width:10%;">Diferencia</th>
                                        <th class="num" style="width:13%;">Impacto</th>
                                        <th style="width:9%;">Resultado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data['product_rows']" t-as="row">
                                        <tr>
                                            <td><t t-if="row['code']"><strong>[<span t-esc="row['code']"/>] </strong></t><span t-esc="row['name']"/></td>
                                            <td class="num" t-esc="row['positions']"/>
                                            <td class="num" t-esc="row['lots_count']"/>
                                            <td class="num" t-esc="'{:,.2f}'.format(row['expected_qty'])"/>
                                            <td class="num" t-esc="'{:,.2f}'.format(row['counted_qty'])"/>
                                            <td class="num" t-esc="'{:+,.2f}'.format(row['difference_qty'])"/>
                                            <td class="num"><span t-att-class="'ei-money-neg' if row['impact_value'] &lt; 0 else ('ei-money-pos' if row['impact_value'] &gt; 0 else '')" t-esc="row['impact_value_fmt']"/></td>
                                            <td><span t-att-class="'ei-badge ei-' + row['result_class']" t-esc="row['result']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="ei-footer">
                                Fin del acta · <span t-esc="doc.name"/> · <span t-esc="data['final_result_label']"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="setu_inventory_count_executive_report_form_extension" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.executive.report.form.extension</field>
        <field name="model">setu.stock.inventory.count</field>
        <field name="inherit_id" ref="setu_inventory_count_management.setu_stock_inventory_count_form_view"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_print_executive_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-pdf-o"
                        string="Informe ejecutivo"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state not in ('Approved', 'Inventory Adjusted')"/>
            </xpath>
        </field>
    </record>
</odoo>
