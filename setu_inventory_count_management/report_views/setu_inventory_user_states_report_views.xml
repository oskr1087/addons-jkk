<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="setu_inventory_user_states_report_tree_view" model="ir.ui.view">
            <field name="name">setu.inventory.user.states.report.tree.view</field>
            <field name="model">setu.inventory.user.states.report</field>
            <field name="arch" type="xml">
                <list string="Sesión de inventario" create="0" edit="0" delete="0">
                    <field name="user_id"/>
                    <field name="sessions"/>
                    <field name="mistake_sessions"/>
                    <field name="user_mistake_ratio" string="Calculation Mistake(%)"/>
                    <field name="company_id" column_invisible="1"/>
                </list>
            </field>
        </record>


        <record id="setu_inventory_user_states_report_graph_view" model="ir.ui.view">
            <field name="name">setu.inventory.user.states.report.graph.view</field>
            <field name="model">setu.inventory.user.states.report</field>
            <field name="arch" type="xml">
                <graph string="Gráfico de estadísticas de usuarios" type="bar" stacked="False">
                    <field name="user_id" type="row"/>
                    <field name="user_mistake_ratio" type="measure"/>
                </graph>
            </field>
        </record>


        <record id="setu_inventory_user_states_report_search_view" model="ir.ui.view">
            <field name="name">setu.inventory.user.states.report.search.view</field>
            <field name="model">setu.inventory.user.states.report</field>
            <field name="arch" type="xml">
                <search string="Reporte de estadísticas de usuarios">
                    <field name="user_id" string="Usuario"/>
                </search>
            </field>
        </record>

        <record id="setu_inventory_user_states_report_action" model="ir.actions.act_window">
            <field name="name">Inventory User Statistics Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.inventory.user.states.report</field>
            <field name="view_mode">list,graph</field>
            <field name="context">{'search_default_group_by_session_id':1}</field>
            <field name="domain">[('company_id', 'in',allowed_company_ids)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    There are no Inventory Sessions completed.
                </p>
            </field>
        </record>


        <record id="setu_inventory_user_states_report_sever_action" model="ir.actions.server">
            <field name="name">Inventory User Statistics Report</field>
            <field name="model_id" ref="setu_inventory_count_management.model_setu_inventory_user_states_report"/>
            <field name="state">code</field>
            <field name="code">action = model.generate_report()</field>
        </record>

        <menuitem name="User Statistics Report" id="setu_inventory_user_states_report_menu" parent="setu_inventory_count_management.setu_inventory_reporting_menu" action="setu_inventory_count_management.setu_inventory_user_states_report_sever_action" sequence="4"/>
    </data>
</odoo>