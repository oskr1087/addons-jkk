<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="setu_inventory_count_management.MobileBarcodeField">
        <div class="setu_inventory_mobile_scanner mt-2 mb-3">
            <button
                type="button"
                class="btn btn-primary btn-lg setu_inventory_scan_button"
                t-on-click="openMobileScanner"
                title="Escanear QR o código de barras con la cámara"
            >
                <i class="fa fa-camera me-2" aria-hidden="true"/>
                <span>Escanear QR / Código</span>
            </button>
            <div class="setu_inventory_scan_hint mt-2 text-muted">
                En la app Odoo se usa el lector nativo. En navegador se usa la cámara web. También puede usar un lector PDA, Bluetooth o USB.
            </div>
        </div>
    </t>
</templates>
