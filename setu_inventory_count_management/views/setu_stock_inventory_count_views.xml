<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="setu_stock_inventory_count_form_view" model="ir.ui.view">
            <field name="name">setu_stock_inventory_count.form</field>
            <field name="model">setu.stock.inventory.count</field>
            <field name="arch" type="xml">
                <form string="Conteo de inventario">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="Draft,In Progress,To Be Approved"/>
                        <field name="start_inventory_bool" invisible="1"/>
                        <field name="create_session_bool" invisible="1"/>
                        <field name="inventory_adj_ids" invisible="1"/>
                        <field name="session_ids" invisible="1"/>
                        <field name="id" invisible="1"/>
                        <button name="create_session" invisible="not create_session_bool" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" string="Crear sesión" class="oe_highlight"/>
                        <button name="approve_all_lines" type="object" string="Aprobar líneas de conteo" groups="setu_inventory_count_management.group_setu_inventory_count_manager" class="oe_highlight" invisible="state != 'To Be Approved' or type == 'Single Session' or not line_ids"/>
                        <button name="reject_all_lines" type="object" invisible="state != 'To Be Approved' or type == 'Single Session' or not line_ids" string="Rechazar líneas de conteo" groups="setu_inventory_count_management.group_setu_inventory_count_manager" class="oe_highlight"/>
                        <button name="create_re_count" type="object" string="Crear reconteo" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="not create_count_bool"/>
                        <button name="reject_inventory_count" invisible="state != 'To Be Approved'" type="object" string="Rechazar" confirm="¿Está seguro de rechazar el conteo de inventario?" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
                        <button name="approve_inventory_count" invisible="state != 'To Be Approved'" type="object" string="Validar" confirm="¿Está seguro de validar el conteo de inventario?" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
                        <button name="create_inventory_adj" invisible="not start_inventory_bool or state != 'Approved'" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" string="Crear ajuste de inventario" class="oe_highlight"/>
                        <button name="complete_counting" invisible="state != 'In Progress'" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" string="Completar conteo" class="oe_highlight"/>
                        <button name="cancel" confirm="¿Está seguro de cancelar el conteo de inventario?" invisible="state != 'Draft' or not id" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" string="Cancelar" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_user_mistake_lines" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="user_mistake_ratio &lt;= 0" type="object" class="oe_stat_button">
                                <field name="user_mistake_ratio" string="Error del usuario" widget="percentpie"/>
                            </button>
                            <button name="action_open_discrepancy_lines" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="discrepancy_ratio &lt;= 0" type="object" class="oe_stat_button">
                                <field name="discrepancy_ratio" string="Discrepancia" widget="percentpie"/>
                            </button>
                            <button name="action_open_sessions" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="count_session_ids == 0">
                                <field name="count_session_ids" widget="statinfo" string="Sesión"/>
                            </button>
                            <button name="action_open_counts" type="object" class="oe_stat_button" groups="setu_inventory_count_management.group_setu_inventory_count_manager" icon="fa-rotate-left" invisible="re_count_ids == 0">
                                <field name="re_count_ids" widget="statinfo" string="Reconteo"/>
                            </button>
                            <button name="action_open_inventory_adj" type="object" string="Ajuste de inventario" groups="setu_inventory_count_management.group_setu_inventory_count_manager" class="oe_stat_button" icon="fa-exchange" invisible="not inventory_adj_ids">
                            </button>
                        </div>
                        <div>
                            <h1>
                                <field name="name" readonly="1" nolabel="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="count_id" string="Conteo principal" invisible="not count_id"/>
                                <field name="approver_id" required="1" readonly="state != 'Draft'" options="{'no_create': True, 'no_open':True}" domain="[('id','in',approver_ids)]"/>
                                <field name="approver_ids" invisible="1"/>
                                <field name="planner_id" invisible="not planner_id"/>
                                <!--                                <field name="user_id"/>-->

                                <field name="type" readonly="count_session_ids &gt; 0"/>
                                <field name="use_barcode_scanner" widget="boolean_toggle" readonly="state != 'Draft'"/>
                                <field name="create_count_bool" invisible="1"/>
                            </group>
                            <group>
                                <field name="inventory_count_date" readonly="state != 'Draft'"/>
                                <field name="warehouse_id" required="1" readonly="state != 'Draft'" options="{'no_create': True, 'no_open':True}"/>
                                <field name="location_id" required="1" readonly="state != 'Draft'" domain="[('id','in',locations_ids)]" options="{'no_create': True, 'no_open':True}"/>
                                <field name="locations_ids" invisible="1"/>

                                <field name="company_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas de conteo de inventario" invisible="not line_ids">
                                <field name="line_ids">
                                    <list decoration-danger="is_system_generated" editable="bottom" create="false" delete="false">
                                        <field name="user_ids" widget="many2many_tags" readonly="1" column_invisible="1"/>
                                        <field name="product_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="tracking" column_invisible="1"/>
                                        <field name="serial_number_ids" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="not_found_serial_number_ids" widget="many2many_tags" readonly="1"/>
                                        <field name="lot_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="location_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="theoretical_qty" string="Cantidad teórica" column_invisible="parent.state != 'Draft'" readonly="1"/>
                                        <field name="qty_in_stock" string="Cantidad teórica" readonly="1" column_invisible="parent.state == 'Draft'"/>
                                        <field name="counted_qty" readonly="parent.state != 'To Be Approved'"/>
                                        <field name="is_discrepancy_found" readonly="1" string="Discrepancia"/>
                                        <field name="user_calculation_mistake" readonly="1" column_invisible="parent.type == 'Multi Session'"/>
                                        <field name="difference_qty" readonly="1"/>
                                        <field name="discrepancy_value" readonly="1" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
                                        <field name="state" column_invisible="parent.state not in ['To Be Approved', 'Approved'] or parent.type == 'Single Session'" readonly="parent.state in ['Approved']"/>
                                        <field name="is_system_generated" column_invisible="1"/>
                                        <button string="Aprobar" invisible="parent.state not in ['To Be Approved']" style="font-size: 1rem; font-weight: bold;" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" name="change_line_state_to_approve"/>
                                        <button string="Rechazar" invisible="parent.state not in ['To Be Approved']" class="oe_highlight" style="background-color:red; font-size: 1rem; font-weight: bold;" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" name="change_line_state_to_reject"/>
                                    </list>

                                </field>
                            </page>
                            <page string="Productos" invisible="not product_ids">
                                <field name="product_ids" readonly="session_ids" domain="[('type','=','product')]" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}">
                                    <list>
                                        <field name="default_code"/>
                                        <field name="name"/>
                                        <field name="barcode"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Líneas de movimientos de stock" invisible="not stock_move_line_ids">
                                <field name="stock_move_line_ids" nolabel="1" readonly="1" options="{'no_open':True}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>

                </form>
            </field>
        </record>

        <record id="setu_stock_inventory_count_tree_view" model="ir.ui.view">
            <field name="name">.setu_stock_inventory_count.tree</field>
            <field name="model">setu.stock.inventory.count</field>
            <field name="arch" type="xml">
                <list string="Conteo de inventario" decoration-muted="state=='Cancel'" default_order="id desc">
                    <field name="name"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="approver_id"/>
                    <field name="inventory_count_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="setu_stock_inventory_count_line_tree_view" model="ir.ui.view">
            <field name="name">.setu_stock_inventory_count.line.tree</field>
            <field name="model">setu.stock.inventory.count.line</field>
            <field name="arch" type="xml">
                <list string="Líneas de conteo de inventario" create="0" edit="0" delete="0">
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="is_multi_session" column_invisible="True"/>
                    <field name="qty_in_stock" string="Cantidad teórica"/>
                    <field name="counted_qty"/>
                    <field name="is_discrepancy_found" string="Discrepancia"/>
                    <field name="user_calculation_mistake"/>
                </list>
            </field>
        </record>

        <record id="setu_stock_inventory_count_line_form_view" model="ir.ui.view">
            <field name="name">.setu_stock_inventory_count.line.form</field>
            <field name="model">setu.stock.inventory.count.line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="inventory_count_id"/>
                                <field name="product_id"/>
                                <field name="location_id"/>
                                <field name="theoretical_qty"/>
                                <field name="qty_in_stock"/>
                                <field name="counted_qty"/>
                                <field name="serial_number_ids" widget="many2many_tags"/>
                                <field name="not_found_serial_number_ids" widget="many2many_tags"/>
                                <field name="lot_id"/>
                            </group>
                            <group>
                                <field name="tracking"/>
                                <field name="is_discrepancy_found"/>
                                <field name="is_multi_session"/>
                                <field name="user_calculation_mistake"/>
                                <field name="is_system_generated"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="setu_stock_inventory_count_search_view" model="ir.ui.view">
            <field name="name">setu_stock_inventory_count.search</field>
            <field name="model">setu.stock.inventory.count</field>
            <field name="arch" type="xml">
                <search string="Conteo de inventario">
                    <field name="name" string="Name" filter_domain="['|','|',('name','ilike',self),('location_id','ilike',self),('warehouse_id','ilike',self)]"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="approver_id"/>
                    <field name="inventory_count_date"/>
                    <filter string="Borrador" name="Draft" domain="[('state', '=', 'Draft')]"/>
                    <filter string="Por aprobar" name="To Be Approved" domain="[('state', '=', 'To Be Approved')]"/>
                    <filter string="Aprobado" name="Approved" domain="[('state', '=', 'Approved')]"/>
                    <filter string="Cancelar" name="Cancel" domain="[('state', '=', 'Cancel')]"/>
                    <filter string="Discrepancia" name="with_discrepancy" domain="[('discrepancy_ratio','&gt;',0)]"/>
                    <filter string="Inventario ajustado" name="with_inventory_adj" domain="[('inventory_adj_ids', '!=', False)]"/>
                    <separator/>
                    <filter string="Sesión única" name="Single Session" domain="[('type', '=', 'Single Session')]"/>
                    <filter string="Múltiples sesiones" name="Multi Session" domain="[('type', '=', 'Multi Session')]"/>
                    <filter string="Estado" domain="[]" name="state" context="{'group_by':'state'}"/>
                    <filter string="Ubicación" domain="[]" name="location" context="{'group_by':'location_id'}"/>
                    <filter string="Almacén" domain="[]" name="warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter string="Controlador" domain="[]" name="approver" context="{'group_by':'approver_id'}"/>
                    <filter string="Fecha" name="date" domain="[]" context="{'group_by': 'inventory_count_date'}" help="Fecha por mes"/>
                </search>
            </field>
        </record>

        <record id="setu_stock_inventory_count_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Counts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory.count</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    Cree un conteo para definir almacén, ubicación, productos, aprobador y sesiones. Luego los bodegueros podrán ejecutar el conteo desde la interfaz móvil/PDA.
                </p>
            </field>
        </record>

        <record id="new_inventory_count_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Counts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory.count</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    No existen conteos de inventario todavía. Cree uno para iniciar el flujo de sesiones, conteo, revisión y ajuste.
                </p>
            </field>
        </record>

        <menuitem name="Inventory Counts" id="setu_inventory_count_root" web_icon="setu_inventory_count_management,static/description/icon.png"/>

        <menuitem name="Documents" id="main_documents_menu" parent="setu_inventory_count_management.setu_inventory_count_root"/>

        <menuitem name="Inventory Counts" id="setu_stock_inventory_count_menu" parent="setu_inventory_count_management.main_documents_menu" action="setu_stock_inventory_count_act_window" groups="setu_inventory_count_management.group_setu_inventory_count_manager" sequence="0"/>
    </data>
</odoo>