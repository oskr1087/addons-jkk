<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="setu_stock_inventory_count_planner_form_view" model="ir.ui.view">
            <field name="name">setu_stock_inventory_count_planner.form</field>
            <field name="model">setu.stock.inventory.count.planner</field>
            <field name="arch" type="xml">
                <form string="Planificador de conteos de inventario">
                    <header>
                        <button name="verify_inventory_count_planing" string="verify" type="object" invisible="not active or state != 'draft'" class="btn-primary"/>
                        <button name="create_inventory_count" string="Run Manually" type="object" invisible="not active or state == 'draft'" class="btn-primary"/>
                        <button name="reset_to_draft" string="Reset To Draft" type="object" invisible="not active or state == 'draft'" class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                    </header>
                    <sheet>
                        <div>
                            <h1>
                                <field name="name" required="1" nolabel="1" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="approver_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open':True}" domain="[('id','in',approver_ids)]"/>
                                <field name="approver_ids" invisible="1"/>
                                <field name="inventory_count_date" readonly="state != 'draft'"/>
                                <field name="use_barcode_scanner" widget="boolean_toggle"/>
                                <field name="active" invisible="1"/>
                                <separator string="Scheduler Configuration" colspan="4"/>
                                <field name="planing_frequency" required="1" readonly="state != 'draft'"/>
                                <field name="previous_execution_date" readonly="state != 'draft'"/>
                                <field name="next_execution_date" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="warehouse_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open':True}"/>
                                <field name="location_id" required="1" readonly="state != 'draft'" domain="[('id','in',locations_ids)]" options="{'no_create': True, 'no_open':True}"/>
                                <field name="company_id" required="1" readonly="1" invisible="not warehouse_id" options="{'no_create': True, 'no_open':True}"/>
                                <field name="locations_ids" invisible="1"/>
                                <separator string="Configuración de productos" colspan="4"/>
                                <field name="type" widget="radio"/>

                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="setu_stock_inventory_count_planner_tree_view" model="ir.ui.view">
            <field name="name">setu_stock_inventory_count_planner.tree</field>
            <field name="model">setu.stock.inventory.count.planner</field>
            <field name="arch" type="xml">
                <list string="Conteo de inventario" decoration-muted="state=='Cancel'" create="true" default_order="id desc">
                    <field name="name"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="approver_id"/>
                    <field name="inventory_count_date"/>
                    <field name="state"/>
                    <field name="type" column_invisible="1"/>
                </list>
            </field>
        </record>
        <record id="setu_stock_inventory_count_planner_search_view" model="ir.ui.view">
            <field name="name">setu.stock.inventory.count.planner.search</field>
            <field name="model">setu.stock.inventory.count.planner</field>
            <field name="arch" type="xml">
                <search string="Planificador de conteos de inventario">
                    <field name="name"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="approver_id"/>
                    <field name="inventory_count_date"/>
                    <field name="type"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'type'}"/>
                    <filter string="Ubicación" name="group_location" context="{'group_by':'location_id'}"/>
                    <filter string="Almacén" name="group_warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter string="Controlador" name="group_approver" context="{'group_by':'approver_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by':'inventory_count_date'}"/>
                </search>
            </field>
        </record>


        <record id="setu_stock_inventory_count_planner_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Count Planners</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory.count.planner</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    There is no Inventory Count Planner.
                </p>
                <p>
                    Click create to add new Inventory Count Planner.
                </p>
            </field>
        </record>

        <menuitem name="Configuration" id="main_configuration_menu" parent="setu_inventory_count_management.setu_inventory_count_root" sequence="1000"/>


        <menuitem name="Inventory Count Planners" id="setu_stock_inventory_count_planner_menu" parent="setu_inventory_count_management.main_configuration_menu" action="setu_stock_inventory_count_planner_act_window" groups="setu_inventory_count_management.group_setu_inventory_count_manager" sequence="2"/>

    </data>
</odoo>