<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================
         CONTEOS: Kanban operativo como vista principal
         ================================================================ -->
    <record id="setu_stock_inventory_count_kanban_view" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.kanban.modern</field>
        <field name="model">setu.stock.inventory.count</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column setu_kanban_modern">
                <field name="name"/>
                <field name="state"/>
                <field name="inventory_count_date"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="approver_id"/>
                <field name="user_id"/>
                <field name="type"/>
                <field name="count_session_ids"/>
                <field name="rejected_lines_count"/>
                <field name="discrepancy_ratio"/>
                <field name="create_session_bool"/>
                <templates>
                    <t t-name="card">
                        <div class="setu_kcard">
                            <div class="setu_kcard_head">
                                <div>
                                    <span class="setu_kcard_eyebrow">CONTEO DE INVENTARIO</span>
                                    <h3><field name="name"/></h3>
                                </div>
                                <span class="setu_state_badge"
                                      t-att-class="'state-' + (record.state.raw_value || '').toLowerCase()">
                                    <field name="state"/>
                                </span>
                            </div>

                            <div class="setu_kcard_location">
                                <i class="fa fa-map-marker" title="Ubicación"/>
                                <div>
                                    <strong><field name="location_id"/></strong>
                                    <small><field name="warehouse_id"/></small>
                                </div>
                            </div>

                            <div class="setu_kcard_metrics">
                                <div>
                                    <strong><field name="count_session_ids"/></strong>
                                    <span>Sesiones</span>
                                </div>
                                <div>
                                    <strong><field name="rejected_lines_count"/></strong>
                                    <span>Rechazadas</span>
                                </div>
                                <div>
                                    <strong><field name="discrepancy_ratio"/>%</strong>
                                    <span>Discrepancia</span>
                                </div>
                            </div>

                            <div class="setu_kcard_info">
                                <span><i class="fa fa-calendar" title="Fecha"/> <field name="inventory_count_date"/></span>
                                <span><i class="fa fa-user" title="Controlador"/> <field name="approver_id"/></span>
                                <span><i class="fa fa-object-group" title="Tipo"/> <field name="type"/></span>
                            </div>

                            <div class="setu_kcard_footer">
                                <span class="text-muted">Creado por <field name="user_id"/></span>
                                <button name="create_session"
                                        type="object"
                                        string="Crear sesión"
                                        icon="fa-plus"
                                        class="btn btn-primary btn-sm"
                                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                                        invisible="not create_session_bool"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SESIONES: reemplazo del Kanban anterior por uno limpio y operativo
         ================================================================ -->
    <record id="setu_inventory_count_session_kanban_view" model="ir.ui.view">
        <field name="name">setu.inventory.count.session.kanban.modern</field>
        <field name="model">setu.inventory.count.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="false" edit="false" delete="false"
                    class="o_kanban_small_column setu_kanban_modern">
                <field name="name"/>
                <field name="state"/>
                <field name="current_state"/>
                <field name="inventory_count_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="approver_id"/>
                <field name="user_ids"/>
                <field name="user_ids_count"/>
                <field name="total_products"/>
                <field name="total_scanned_products"/>
                <field name="to_be_scanned"/>
                <field name="session_start_date"/>
                <field name="session_submit_date"/>
                <field name="time_taken"/>
                <templates>
                    <t t-name="card">
                        <div class="setu_kcard setu_session_card">
                            <div class="setu_kcard_head">
                                <div>
                                    <span class="setu_kcard_eyebrow">SESIÓN DE CONTEO</span>
                                    <h3><field name="name"/></h3>
                                </div>
                                <span class="setu_state_badge"
                                      t-att-class="'state-' + (record.state.raw_value || '').toLowerCase()">
                                    <field name="state"/>
                                </span>
                            </div>

                            <div class="setu_kcard_location">
                                <i class="fa fa-map-marker" title="Ubicación"/>
                                <div>
                                    <strong><field name="location_id"/></strong>
                                    <small><field name="warehouse_id"/></small>
                                </div>
                            </div>

                            <div class="setu_kcard_metrics">
                                <div>
                                    <strong><field name="total_products"/></strong>
                                    <span>Productos</span>
                                </div>
                                <div>
                                    <strong><field name="total_scanned_products"/></strong>
                                    <span>Escaneados</span>
                                </div>
                                <div>
                                    <strong><field name="to_be_scanned"/></strong>
                                    <span>Pendientes</span>
                                </div>
                            </div>

                            <div class="setu_kcard_info">
                                <span><i class="fa fa-list-alt" title="Conteo"/> <field name="inventory_count_id"/></span>
                                <span><i class="fa fa-users" title="Usuarios"/> <field name="user_ids_count"/> usuario(s)</span>
                                <span t-if="record.session_start_date.raw_value">
                                    <i class="fa fa-clock-o" title="Inicio"/> <field name="session_start_date"/>
                                </span>
                            </div>

                            <div class="setu_kcard_footer">
                                <span class="text-muted">
                                    <i class="fa fa-user-circle" title="Controlador"/> <field name="approver_id"/>
                                </span>
                                <button name="action_open_mobile_count"
                                        type="object"
                                        string="Conteo PDA"
                                        icon="fa-mobile"
                                        class="btn btn-primary btn-sm"
                                        invisible="state in ['Submitted', 'Done', 'Cancel']"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         PLANIFICADORES: Kanban por estado
         ================================================================ -->
    <record id="setu_stock_inventory_count_planner_kanban_view" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.planner.kanban.modern</field>
        <field name="model">setu.stock.inventory.count.planner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column setu_kanban_modern">
                <field name="name"/>
                <field name="state"/>
                <field name="active"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="approver_id"/>
                <field name="type"/>
                <field name="planing_frequency"/>
                <field name="next_execution_date"/>
                <field name="previous_execution_date"/>
                <templates>
                    <t t-name="card">
                        <div class="setu_kcard">
                            <div class="setu_kcard_head">
                                <div>
                                    <span class="setu_kcard_eyebrow">PLANIFICADOR</span>
                                    <h3><field name="name"/></h3>
                                </div>
                                <span class="setu_state_badge">
                                    <field name="state"/>
                                </span>
                            </div>

                            <div class="setu_kcard_location">
                                <i class="fa fa-building" title="Almacén"/>
                                <div>
                                    <strong><field name="warehouse_id"/></strong>
                                    <small><field name="location_id"/></small>
                                </div>
                            </div>

                            <div class="setu_kcard_metrics">
                                <div>
                                    <strong><field name="planing_frequency"/></strong>
                                    <span>Días</span>
                                </div>
                                <div>
                                    <strong><field name="type"/></strong>
                                    <span>Tipo</span>
                                </div>
                            </div>

                            <div class="setu_kcard_info">
                                <span><i class="fa fa-calendar-check-o" title="Próxima ejecución"/> <field name="next_execution_date"/></span>
                                <span><i class="fa fa-history" title="Última ejecución"/> <field name="previous_execution_date"/></span>
                                <span><i class="fa fa-user" title="Controlador"/> <field name="approver_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
