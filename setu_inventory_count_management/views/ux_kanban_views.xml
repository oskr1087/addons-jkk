                                <span><i class="fa fa-user" title="Responsable"/> <field name="user_id"/></span>
                            </div>
                            <div class="setu_kcard_metrics">
                                <div><strong><field name="theoretical_qty"/></strong><span>Teórico</span></div>
                                <div><strong><field name="counted_qty"/></strong><span>Contado</span></div>
                                <div><strong><field name="discrepancy_qty"/></strong><span>Ajuste</span></div>
                            </div>
                            <div class="setu_kcard_footer">
                                <span><i class="fa fa-calendar" title="Fecha"/> <field name="inventory_count_date"/></span>
                                <strong>Valor: <field name="discrepancy_value"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
