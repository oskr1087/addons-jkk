                                      t-att-class="record.adjustment_type.raw_value === 'IN' ? 'is-in' : 'is-out'">
                                    <field name="adjustment_type"/>
                                </span>
                            </div>
                            <div class="setu_kcard_info">
                                <span><i class="fa fa-list-alt" title="Conteo"/> <field name="count_id"/></span>
