                            <div class="setu_kcard_footer">
                                <span>Discrepancia: <strong><field name="discrepancy_ratio"/>%</strong></span>
                                <span>Promedio: <strong><field name="avg_time_per_session" widget="float_time"/></strong></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

