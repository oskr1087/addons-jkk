    <!-- ================================================================
         FORMULARIOS: organización visual consistente
         ================================================================ -->

    <record id="inventory_count_session_form_modern" model="ir.ui.view">
        <field name="name">setu.inventory.count.session.form.modern</field>
        <field name="model">setu.inventory.count.session</field>
        <field name="inherit_id" ref="setu_inventory_count_management.inventory_count_session_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="setu_form_modern setu_session_form_modern" separator=" "/>
            </xpath>

            <xpath expr="//div[contains(@style, 'antiquewhite')]" position="replace">
                <div class="setu_session_help" invisible="not use_barcode_scanner">
                    <div class="setu_session_help_icon">
                        <i class="fa fa-barcode" title="Código de barras"/>
                    </div>
                    <div>
                        <strong>Flujo de conteo con PDA</strong>
                        <span>
                            Abra <b>Conteo móvil / PDA</b>, escanee el producto y, cuando aplique,
                            el lote o número de serie. La ubicación ya está definida por la sesión.
                        </span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="setu_form_summary">
                    <div class="setu_summary_item">
                        <span>Ubicación</span>
                        <strong><field name="location_id" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Usuarios</span>
                        <strong><field name="user_ids_count" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Escaneados</span>
                        <strong><field name="total_scanned_products" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Pendientes</span>
                        <strong><field name="to_be_scanned" readonly="1" nolabel="1"/></strong>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="setu_stock_inventory_count_planner_form_modern" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.planner.form.modern</field>
        <field name="model">setu.stock.inventory.count.planner</field>
        <field name="inherit_id" ref="setu_inventory_count_management.setu_stock_inventory_count_planner_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="setu_form_modern" separator=" "/>
            </xpath>
            <xpath expr="//sheet/div[h1]" position="after">
                <div class="setu_form_summary">
                    <div class="setu_summary_item">
                        <span>Almacén</span>
                        <strong><field name="warehouse_id" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Ubicación</span>
                        <strong><field name="location_id" readonly="1" nolabel="1"/></strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Frecuencia</span>
                        <strong><field name="planing_frequency" readonly="1" nolabel="1"/> días</strong>
                    </div>
                    <div class="setu_summary_item">
                        <span>Próxima ejecución</span>
                        <strong><field name="next_execution_date" readonly="1" nolabel="1"/></strong>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

