                    No existen sesiones. El supervisor debe crear/asignar una sesión; el bodeguero podrá abrirla directamente en modo Conteo móvil/PDA.
                </p>
            </field>
        </record>


        <menuitem name="Sesiones" id="inventory_count_session_menu" parent="setu_inventory_count_management.main_documents_menu" action="inventory_count_session_act_window" sequence="10"/>

