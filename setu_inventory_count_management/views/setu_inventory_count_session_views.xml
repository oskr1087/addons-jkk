<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="inventory_count_session_form_view" model="ir.ui.view">
            <field name="name">.inventory_count_session.form</field>
            <field name="model">setu.inventory.count.session</field>
            <field name="arch" type="xml">
                <form string="Sesión de conteo de inventario" create="0">
                    <div class="alert alert-info" role="alert" invisible="not current_scanning_location_id">
                        <strong>Currently scanned Details :</strong>
                        <div invisible="not current_scanning_location_id">
                            <strong>Location :</strong>
                            <strong>
                                <field name="current_scanning_location_id" readonly="1" force_save="1"/>
                            </strong>
                        </div>
                        <div invisible="not current_scanning_lot_id">
                            <strong>Lot/Serial Number :</strong>
                            <strong>
                                <field name="current_scanning_lot_id" readonly="1" force_save="1"/>
                            </strong>
                        </div>
                        <div invisible="not current_scanning_product_id">
                            <strong>Product :</strong>
                            <strong>
                                <field name="current_scanning_product_id" readonly="1" force_save="1"/>
                            </strong>
                        </div>
                    </div>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="Draft,In Progress,Done"/>
                        <field name="count_state" invisible="1"/>
                        <field name="is_session_approved" invisible="1"/>
                        <field name="current_state" invisible="1"/>
                        <field name="session_ids" invisible="1"/>
                        <field name="re_open_session_bool" invisible="1"/>
                        <field name="rejected_lines_count" invisible="1"/>
                        <button name="start" type="object" string="Iniciar" class="oe_highlight" invisible="state == 'Cancel' or current_state != 'Created'"/>
                        <button name="action_open_mobile_count" type="object" string="Conteo móvil / PDA" class="btn-primary" icon="fa-mobile" invisible="state in ['Submitted', 'Done', 'Cancel']"/>
                        <button name="pause" type="object" string="Pausar" class="oe_highlight" invisible="state == 'Cancel' or current_state in ['Created','Pause','End']"/>
                        <button name="resume" type="object" string="Reanudar" class="oe_highlight" invisible="state == 'Cancel' or current_state in ['Created','Resume','Start','End']"/>
                        <button name="submit" type="object" string="Finalizar sesión" class="oe_highlight" invisible="state == 'Cancel' or current_state not in ['Start','Resume']"/>
                        <button name="approve_all_lines" type="object" string="Aprobar líneas de sesión" groups="setu_inventory_count_management.group_setu_inventory_count_manager" class="oe_highlight" invisible="1"/>
                        <button name="reject_all_lines" type="object" string="Rechazar líneas de sesión" groups="setu_inventory_count_management.group_setu_inventory_count_manager" class="oe_highlight" invisible="1"/>
                        <button name="create_re_session" type="object" string="Crear sesión de reconteo" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="1"/>
                        <button name="validate_session" type="object" string="Validar" class="oe_highlight" confirm="¿Está seguro de validar la sesión?" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="1"/>
                        <button name="cancel_session" type="object" string="Cancelar" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager" confirm="¿Está seguro de cancelar la sesión?" invisible="state != 'Draft'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_session_history" type="object" class="oe_stat_button" icon="fa-clock-o" invisible="current_state == 'Created'">
                                <field name="time_taken"/>
                            </button>
                            <field name="count_child_session_ids" invisible="1"/>
                            <button name="action_open_child_sessions" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="count_child_session_ids == 0">
                                <field name="count_child_session_ids" widget="statinfo" string="Sesión de reconteo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <div style="margin-bottom: 10px;word-wrap: break-word;border: 1px dotted;padding: 3px;font-weight: bold;color: #666666;background: antiquewhite;" invisible="not use_barcode_scanner">
                                <p>
                                    <strong>1.</strong>
                                    Escanee primero la ubicación. Puede usar un lector físico o la cámara del celular.
                                    <br/>
                                    <strong>2.</strong>
                                    El botón <strong>Escanear QR / Código</strong> acepta QR y códigos de barras cuyo contenido sea el código configurado en Odoo.
                                    <br/>
                                         Producto sin seguimiento: escanee directamente el QR/código del producto.
                                    <br/>
                                         Producto por serie: escanee el QR/código del número de serie.
                                    <br/>
                                         Producto por lote: escanee el QR/código del lote y luego el QR/código del producto.
                                    <br/>
                                    <strong>3.</strong>
                                    Cuando cambie de ubicación, escanee primero el QR/código de la nueva ubicación.
                                </p>
                            </div>
                            <div>
                                <h1>
                                    <field name="name" nolabel="1" readonly="1"/>
                                </h1>
                            </div>

                        </div>
                        <group>
                            <group>
                                <field name="_barcode_scanned" widget="barcode_handler"/>

                                <field name="inventory_count_id" readonly="1" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
                                <field name="user_ids" widget="many2many_tags" readonly="state != 'Draft'"/>
                                <field name="location_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                <field name="warehouse_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                <field name="company_id" invisible="1"/>
                                <field name="use_barcode_scanner" readonly="1"/>
                            </group>
                            <group>
                                <field name="session_start_date" readonly="1" invisible="1"/>
                                <field name="session_end_date" readonly="1" invisible="1"/>
                                <field name="session_submit_date" string="Fecha de envío" readonly="1" invisible="not session_submit_date"/>
                                <field name="total_products" readonly="1"/>
                                <field name="total_scanned_products" readonly="1"/>
                                <field name="is_multi_session" invisible="1"/>
                                <field name="to_be_scanned" readonly="1"/>
                                <field name="type"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas de sesión">
                                <field name="session_line_ids" force_save="1" nolabel="1" readonly="current_state not in ['Start', 'Resume']">
                                    <list decoration-muted="state=='Reject'" decoration-danger="is_system_generated" delete="true" editable="bottom" decoration-primary="state=='Pending Review'">
                                        <field name="date_of_scanning" column_invisible="True"/>
                                        <field name="user_ids" widget="many2many_tags" readonly="1" column_invisible="1"/>
                                        <field name="product_id" required="True" force_save="1" domain="[('is_storable', '=', True)]" options="{'no_create': True, 'no_open':True}" readonly="parent.use_barcode_scanner"/>
                                        <field name="tracking" column_invisible="True" readonly="parent.use_barcode_scanner"/>
                                        <field name="serial_number_ids" widget="many2many_tags" force_save="1" domain="[('product_id', '=', product_id)]" options="{'no_create': True, 'no_open':True}" readonly="tracking != 'serial' or parent.use_barcode_scanner" required="tracking == 'serial'"/>
                                        <field name="not_found_serial_number_ids" widget="many2many_tags" force_save="1" readonly="1"/>
                                        <field name="lot_id" force_save="1" options="{'no_create': True, 'no_open':True}" domain="[('product_id', '=', product_id)]" readonly="parent.use_barcode_scanner or tracking != 'lot'" required="tracking == 'lot'"/>
                                        <field name="location_id" force_save="1" required="1" domain="[('usage','=','internal'),('company_id','=',parent.company_id)]" options="{'no_create': True, 'no_open':True}" readonly="parent.use_barcode_scanner"/>
                                        <field name="theoretical_qty" force_save="1" groups="setu_inventory_count_management.group_setu_inventory_count_manager" readonly="1"/>
                                        <field name="is_multi_session" column_invisible="True"/>
                                        <field name="scanned_qty" string="Cantidad contada" force_save="1" readonly="product_scanned or parent.current_state in ['Created','Pause','End'] or not product_id or not location_id"/>
                                        <field name="difference_qty" readonly="1" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
<!--                                        <field name="discrepancy_value" readonly="1"/>-->
                                        <field name="state" readonly="1" column_invisible="parent.type == 'Multi Session' or parent.state not in ['Submitted', 'Done']" style="text-align:center !important;"/>
                                        <field name="user_calculation_mistake" groups="setu_inventory_count_management.group_setu_inventory_count_manager" style="text-align:center !important;" force_save="1" column_invisible="parent.type == 'Multi Session'"/>
                                        <field name="product_scanned" string="Scanned?" style="text-align:center !important;" readonly="not product_id or parent.current_state in ['Created','Pause','End']"/>
                                        <field name="is_system_generated" column_invisible="True"/>
                                        <!--                                        <button string="Scan"-->
                                        <!--                                                invisible="parent.current_state not in ['Start','Resume'] or product_scanned"-->
                                        <!--                                                style="font-size: 1rem; font-weight: bold;"-->
                                        <!--                                                class="oe_highlight"-->
                                        <!--                                                type="object"-->
                                        <!--                                                name="set_mark_scanned"/>-->
                                        <!--                                        <button string="Unscan"-->
                                        <!--                                                invisible="parent.current_state not in ['Start','Resume'] or not product_scanned"-->
                                        <!--                                                style="font-size: 1rem; font-weight: bold;"-->
                                        <!--                                                class="oe_highlight"-->
                                        <!--                                                type="object"-->
                                        <!--                                                name="set_mark_unscanned"/>-->
                                        <button string="Aprobar" invisible="parent.state != 'Submitted' or is_multi_session" style="font-size: 1rem; font-weight: bold;" class="oe_highlight" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" name="change_line_state_to_approve"/>
                                        <button string="Rechazar" invisible="parent.state != 'Submitted' or is_multi_session" class="oe_highlight" style="background-color:red; font-size: 1rem; font-weight: bold;" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" name="change_line_state_to_reject"/>
                                        <button string="Add as Counted" invisible="parent.state != 'Submitted' or not is_system_generated" class="oe_highlight" style="background-color:green; font-size: 1rem; font-weight: bold;" groups="setu_inventory_count_management.group_setu_inventory_count_manager" type="object" name="set_theoretical"/>

                                    </list>
                                    <form create="0" edit="0">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="session_id" readonly="1"/>
                                                    <field name="inventory_count_id" readonly="1"/>
                                                    <field name="inventory_count_line_id" invisible="1"/>
                                                    <field name="location_id" readonly="1"/>
                                                    <field name="is_multi_session" readonly="1"/>
                                                    <field name="date_of_scanning" invisible="1"/>
                                                </group>
                                                <group>
                                                    <field name="product_id" readonly="1"/>
                                                    <field name="tracking" invisible="1"/>
                                                    <field name="serial_number_ids" widget="many2many_tags" invisible="not serial_number_ids"/>
                                                    <field name="not_found_serial_number_ids" widget="many2many_tags" readonly="1"/>
                                                    <field name="lot_id" invisible="not lot_id" readonly="1"/>
                                                    <field name="theoretical_qty" readonly="1" groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>
                                                    <field name="scanned_qty" readonly="1"/>
                                                    <field name="product_scanned" invisible="1"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                    <field name="_barcode_scanned" widget="barcode_handler"/>
                </form>
            </field>
        </record>


        <!-- Dedicated one-hand counting view for phones and warehouse PDAs.
             Administrative fields, chatter and approval controls intentionally stay out
             of this screen so an operator only sees what is needed to count. -->
        <record id="inventory_count_session_mobile_form_view" model="ir.ui.view">
            <field name="name">setu.inventory.count.session.mobile.form</field>
            <field name="model">setu.inventory.count.session</field>
            <field name="priority">5</field>
            <field name="arch" type="xml">
                <form string="Conteo móvil" create="0" delete="0" class="setu_mobile_count_form">
                    <header class="setu_mobile_count_header">
                        <button name="start" type="object" string="Iniciar" class="oe_highlight setu_mobile_action" invisible="current_state != 'Created' or state == 'Cancel'"/>
                        <button name="resume" type="object" string="Reanudar" class="oe_highlight setu_mobile_action" invisible="current_state != 'Pause' or state == 'Cancel'"/>
                        <button name="pause" type="object" string="Pausar" class="setu_mobile_action" invisible="current_state not in ['Start', 'Resume'] or state == 'Cancel'"/>
                        <button name="submit" type="object" string="Finalizar conteo" class="btn-primary setu_mobile_action" confirm="¿Finalizar y enviar este conteo para revisión?" invisible="current_state not in ['Start', 'Resume'] or state == 'Cancel'"/>
                        <field name="state" widget="statusbar" statusbar_visible="Draft,In Progress,Submitted,Done"/>
                        <field name="current_state" invisible="1"/>
                    </header>
                    <sheet class="setu_mobile_count_sheet">
                        <field name="use_barcode_scanner" invisible="1"/>
                        <field name="mobile_can_set_qty" invisible="1"/>
                        <field name="mobile_is_serial" invisible="1"/>
                        <field name="total_products" invisible="1"/>

                        <div class="setu_mobile_topline">
                            <div>
                                <span class="setu_mobile_session_label">Sesión</span>
                                <h2><field name="name" nolabel="1" readonly="1"/></h2>
                            </div>
                            <div class="setu_mobile_progress_value">
                                <field name="mobile_progress_percent" nolabel="1" readonly="1" widget="percentage"/>
                            </div>
                        </div>

                        <div class="setu_mobile_progress_track" aria-label="Progreso del conteo">
                            <field name="mobile_progress_percent" widget="progressbar" nolabel="1" readonly="1"/>
                        </div>
                        <div class="setu_mobile_progress_caption">
                            <field name="mobile_counted_products" nolabel="1" readonly="1"/> productos contados de
                            <field name="total_products" nolabel="1" readonly="1"/>
                        </div>

                        <div class="setu_mobile_instruction">
                            <i class="fa fa-hand-o-right" title="Indicador" aria-hidden="true"/>
                            <field name="mobile_instruction" nolabel="1" readonly="1"/>
                        </div>

                        <div class="setu_mobile_location" invisible="not current_scanning_location_id">
                            <div class="setu_mobile_section_label"><i class="fa fa-map-marker" title="Indicador"/> UBICACIÓN ACTIVA</div>
                            <div class="setu_mobile_primary_value">
                                <field name="current_scanning_location_id" nolabel="1" readonly="1"/>
                            </div>
                            <button name="action_mobile_clear_location" type="object" string="Cambiar ubicación" class="btn-secondary setu_mobile_secondary_button"/>
                        </div>

                        <div class="setu_mobile_scan_zone" invisible="current_state not in ['Start', 'Resume']">
                            <field name="_barcode_scanned" widget="barcode_handler" nolabel="1"/>
                            <div class="setu_mobile_scanner_note">También puede usar el gatillo del PDA o un lector Bluetooth/USB.</div>
                        </div>

                        <div class="setu_mobile_item" invisible="not current_scanning_product_id">
                            <div class="setu_mobile_section_label"><i class="fa fa-cube" title="Indicador"/> PRODUCTO</div>
                            <div class="setu_mobile_primary_value">
                                <field name="current_scanning_product_id" nolabel="1" readonly="1"/>
                            </div>
                            <div class="setu_mobile_lot" invisible="not current_scanning_lot_id">
                                <span>Lote / Serie</span>
                                <strong><field name="current_scanning_lot_id" nolabel="1" readonly="1"/></strong>
                            </div>

                            <div class="setu_mobile_qty_zone" invisible="not mobile_can_set_qty">
                                <label for="mobile_count_qty" string="CANTIDAD FÍSICA" class="setu_mobile_qty_label"/>
                                <field name="mobile_count_qty" nolabel="1" class="setu_mobile_qty_input"/>
                                <button name="action_mobile_confirm_qty" type="object" string="✓ Confirmar cantidad" class="oe_highlight setu_mobile_confirm_button"/>
                            </div>

                            <div class="setu_mobile_serial_feedback" invisible="not mobile_is_serial">
                                <i class="fa fa-check-circle" title="Indicador"/> Serie registrada: 1 unidad. Continúe escaneando.
                            </div>
                            <button name="action_mobile_clear_item" type="object" string="Cancelar producto" class="btn-link setu_mobile_cancel_item"/>
                        </div>

                        <div class="setu_mobile_recent">
                            <h3>Últimos conteos</h3>
                            <field name="session_line_ids" nolabel="1" readonly="1">
                                <kanban create="false" edit="false" delete="false" default_order="date_of_scanning desc">
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="lot_id"/>
                                    <field name="scanned_qty"/>
                                    <field name="tracking"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="setu_mobile_line_card">
                                                <div class="setu_mobile_line_product"><field name="product_id"/></div>
                                                <div class="setu_mobile_line_meta"><i class="fa fa-map-marker" title="Indicador"/> <field name="location_id"/></div>
                                                <div class="setu_mobile_line_meta" t-if="record.lot_id.raw_value"><i class="fa fa-tag" title="Indicador"/> <field name="lot_id"/></div>
                                                <div class="setu_mobile_line_qty"><field name="scanned_qty"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventory_count_session_tree_view" model="ir.ui.view">
            <field name="name">.inventory_count_session.tree</field>
            <field name="model">setu.inventory.count.session</field>
            <field name="arch" type="xml">
                <list string="Sesión de conteo de inventario" decoration-danger="color==1" decoration-muted="state=='Cancel'" create="0" default_order="id desc">
                    <field name="name"/>
                    <field name="color" column_invisible="True"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="session_start_date"/>
                    <field name="session_submit_date"/>
                    <field name="total_products"/>
                    <field name="total_scanned_products"/>
                    <field name="to_be_scanned"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="setu_inventory_count_session_kanban_view" model="ir.ui.view">
            <field name="name">setu.inventory.count.session.kanban</field>
            <field name="model">setu.inventory.count.session</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" create="false" edit="false" delete="false">
                    <field name="state" readonly="1"/>
                    <field name="id"/>
                    <field name="color"/>
                    <field name="name" readonly="1"/>
                    <field name="user_ids" widget="many2many_tags" readonly="1"/>
                    <field name="to_be_scanned" readonly="1"/>
                    <field name="total_products" readonly="1"/>
                    <field name="total_scanned_products"/>
                    <field name="user_ids_count"/>

                    <!--                    Value shouldn't change when you drag any record in Kanban view-->
                    <field name="create_uid" invisible="1" readonly="1"/>
                    <field name="create_date" invisible="1" readonly="1"/>
                    <field name="current_scanning_location_id" invisible="1" readonly="1"/>
                    <field name="current_state" invisible="1" readonly="1"/>
                    <field name="inventory_count_id" invisible="1" readonly="1"/>
                    <field name="is_multi_session" invisible="1" readonly="1"/>
                    <field name="is_session_approved" invisible="1" readonly="1"/>
                    <field name="write_uid" invisible="1" readonly="1"/>
                    <field name="write_date" invisible="1" readonly="1"/>
                    <field name="location_id" invisible="1" readonly="1"/>
                    <!--                    <field name="message_main_attachment_id" invisible="1" readonly="1"/>-->
                    <field name="access_token" invisible="1" readonly="1"/>
                    <field name="session_ids" invisible="1" readonly="1"/>
                    <field name="session_end_date" invisible="1" readonly="1"/>
                    <field name="session_start_date" invisible="1" readonly="1"/>
                    <field name="session_submit_date" invisible="1" readonly="1"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click o_res_partner_kanban o_kanban_color_#{record.color.raw_value}" style="padding:15px;margin-bottom:13px;border: 1px solid rgba(119,119,119,0.3);transition: all 0.1s ease 0.1s" onMouseOver="this.style.border='1.2px solid rgba(102,204,153,1)',this.style.background='rgba(241,243,244,0.1)'" onMouseOut="this.style.border='1px solid rgba(119,119,119,0.3)',this.style.background='rgba(255,255,255,1)'">

                                <div>
                                    <div>
                                        <h4>
                                            <field name="name"/>
                                        </h4>

                                        <div class="float-start" style="font-size:1rem;margin-top:2px !important;margin-top:-27px !important;">
                                            <div invisible="state not in ['In Progress','Done','Submitted']">
                                                <br/>
                                                <label style="margin-bottom:-6px;font-weight:500;" for="session_start_date">Sesión
                                                    Started :
                                                </label>
                                                <field name="session_start_date"/>
                                            </div>
                                            <div invisible="state not in ['Done','Submitted']">
                                                <label style="margin-bottom:-6px;font-weight:500;" for="session_submit_date">
                                                    Sesión enviada:
                                                </label>
                                                <field name="session_submit_date"/>
                                            </div>

                                            <div invisible="state not in ['In Progress','Done','Submitted']">
                                                <label style="margin-bottom:-6px;font-weight:500;" for="time_taken">Time
                                                    Consumed :
                                                </label>
                                                <field name="time_taken"/>
                                            </div>
                                        </div>
                                    </div>
                                    <br/>
                                    <div style="font-size:1rem;margin-top:-20px;" class="float-start">
                                        <br/>
                                        <div class="pull-left" style="font-size:1rem;margin-top:18px;">
                                            <strong groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                                                Inventory Count :
                                            </strong>
                                            <a name="open_inventory_count" type="object" class="mr-auto" groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                                                <field string="Conteo" name="inventory_count_id"/>
                                            </a>
                                            <br/>
                                            <strong>Location :</strong>
                                            <a name="open_location" type="object" class="mr-auto">
                                                <field name="location_id"/>
                                            </a>
                                            <br/>
                                            <strong>
                                                Assigned To :
                                                <a name="open_user" type="object" class="mr-auto">
                                                    <field name="user_ids_count" string="Usuario"/>
                                                    - User
                                                </a>
                                            </strong>
                                            <br/>
                                            <strong>
                                                Approver :

                                                <a name="open_approver_id" type="object" class="mr-auto">
                                                    <field name="approver_id"/>
                                                </a>
                                            </strong>
                                        </div>
                                        <br/>
                                        <strong>
                                            <a name="open_total_products" type="object" class="mr-auto">
                                                <field name="total_products"/>
                                                - Total Products
                                            </a>
                                        </strong>
                                        <br/>
                                        <strong>
                                            <a name="open_scanned_products" type="object" class="mr-auto">
                                                <field name="total_scanned_products" string="Products Scanned"/>
                                                - Products Scanned
                                            </a>
                                        </strong>
                                        <br/>
                                        <strong>
                                            <a name="open_products_to_be_scanned" type="object" class="mr-auto">
                                                <field name="to_be_scanned" string="Products To Scan"/>
                                                - Products To Scan
                                            </a>
                                        </strong>
                                        <div class="mt-3" invisible="state in ['Submitted', 'Done', 'Cancel']">
                                            <button name="action_open_mobile_count" type="object" string="Abrir conteo móvil" icon="fa-mobile" class="btn btn-primary w-100"/>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="inventory_count_session_search_view" model="ir.ui.view">
            <field name="name">.inventory_count_session.search</field>
            <field name="model">setu.inventory.count.session</field>
            <field name="arch" type="xml">
                <search string="Sesión de conteo de inventario">
                    <field name="name" string="Nombre" filter_domain="['|','|',('name','ilike',self),('user_ids','ilike',self),('location_id','ilike',self)]"/>
                    <field name="user_ids" string="Usuario" filter_domain="[('user_ids','ilike',self)]"/>
                    <field name="location_id"/>
                    <field name="warehouse_id"/>
                    <field name="session_submit_date"/>
                    <filter string="Borrador" name="draft" domain="[('state','=','Draft')]"/>
                    <filter string="Pendiente" name="pending" domain="[('state','=','In Progress')]"/>
                    <filter string="Rechazado" name="rejected" domain="[('state','=','Cancel')]"/>
                    <filter string="Finalizado" name="done" domain="[('state','=','Done')]"/>
                    <separator/>
                    <group>
                        <filter string="Estado" name="state" domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Ubicación" name="group_by_location" context="{'group_by':'location_id'}"/>
                        <filter string="Almacén" name="group_by_warehouse" context="{'group_by':'warehouse_id'}"/>
                        <filter string="Usuario" name="group_by_user" context="{'group_by':'user_ids'}"/>
                        <filter string="Conteo" name="group_by_count" context="{'group_by':'inventory_count_id'}"/>
                        <filter string="Tipo de sesión" name="group_by_type" context="{'group_by':'type'}"/>
                        <filter string="Fecha" name="date" domain="[]" context="{'group_by': 'session_submit_date'}" help="Fecha por mes"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="inventory_count_session_act_window" model="ir.actions.act_window">
            <field name="name">Sesiones</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.inventory.count.session</field>
            <field name="domain">[('inventory_count_id.count_id', '=', False)]</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    No existen sesiones. El supervisor debe crear/asignar una sesión; el bodeguero podrá abrirla directamente en modo Conteo móvil/PDA.
                </p>
            </field>
        </record>

        <record id="inventory_count_session_kanban_act_window" model="ir.actions.act_window">
            <field name="name">Sesiones</field>
            <field name="type">ir.actions.act_window</field>
