<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inventory_count_scan_event_list_view" model="ir.ui.view">
        <field name="name">setu.inventory.count.scan.event.list</field>
        <field name="model">setu.inventory.count.scan.event</field>
        <field name="arch" type="xml">
            <list string="Lecturas QR" create="0" delete="0"
                  decoration-warning="has_observation">
                <field name="scanned_at"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="has_observation"/>
                <field name="observation"/>
            </list>
        </field>
    </record>

    <record id="inventory_count_session_line_observation_extension" model="ir.ui.view">
        <field name="name">setu.inventory.count.session.line.observation</field>
        <field name="model">setu.inventory.count.session</field>
        <field name="inherit_id" ref="setu_inventory_count_management.inventory_count_session_form_view"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='session_line_ids']/list/field[@name='difference_qty']" position="after">
                <field name="has_observation" string="Tiene observaciones" readonly="1"/>
                <field name="observation" string="Observaciones" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
