<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="setu_stock_inventory_form_view" model="ir.ui.view">
            <field name="name">setu.stock.inventory.form</field>
            <field name="model">setu.stock.inventory</field>
            <field name="arch" type="xml">
                <form string="Inventario físico" create="0">
                    <header>
                        <field name="state" readonly="1" widget="statusbar" statusbar_visible="confirm, done"/>
                        <button name="action_cancel" type="object" string="Cancelar" invisible="state not in ['draft', 'confirm']" confirm="¿Está seguro de cancelar este ajuste de inventario?"/>
                        <button name="action_validate" type="object" string="Validar" class="oe_highlight" confirm="¿Está seguro de validar este ajuste de inventario?" invisible="state != 'confirm'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_account_moves"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-book"
                                    invisible="account_move_count == 0">
                                <field name="account_move_count"
                                       widget="statinfo"
                                       string="Asientos contables"/>
                            </button>
                        </div>
                        <field name="account_move_count" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" readonly="1"/>
                            <h1>
                                <field name="name" readonly="1" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field readonly="1" name="partner_id" options="{'no_create': True, 'no_open':True}"/>
                                <field readonly="1" name="inventory_count_id"/>
                            </group>
                            <group>
                                <field readonly="1" name="location_id" options="{'no_create': True, 'no_open':True}"/>
                                <field readonly="1" name="date"/>
                                <field readonly="state != 'draft'" name="company_id" options="{'no_create': True, 'no_open':True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="state not in ['draft','confirm']">
                                    <list editable="bottom" create="0">
                                        <field name="product_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="location_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="prod_lot_id" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="serial_number_ids" widget="many2many_tags" readonly="1" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="theoretical_qty" readonly="1"/>
                                        <field name="product_qty" readonly="parent.state not in ['draft','confirm']"/>
                                        <field name="difference_qty" readonly="1"/>
                                        <field name="discrepancy_value" readonly="1"/>
                                    </list>

                                </field>
                            </page>
                            <page string="Movimientos de stock">
                                <field name="move_ids" readonly="1" options="{'no_open':True}">
                                    <list>
                                        <field name="product_id" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="location_id" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="location_dest_id" options="{'no_create': True, 'no_open':True}"/>
                                        <field name="product_uom_qty"/>
                                        <field name="account_move_id" string="Asiento contable" optional="show"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Contabilidad" invisible="account_move_count == 0">
                                <field name="account_move_ids" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="journal_id"/>
                                        <field name="ref"/>
                                        <field name="state"/>
                                        <field name="amount_total_signed"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setu_stock_inventory_tree_view" model="ir.ui.view">
            <field name="name">setu.stock.inventory.tree</field>
            <field name="model">setu.stock.inventory</field>
            <field name="arch" type="xml">
                <list string="Inventario físico" create="0">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="location_id"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="inventory_count_id"/>
                </list>
            </field>
        </record>
        <record id="setu_stock_inventory_search_view" model="ir.ui.view">
            <field name="name">setu.stock.inventory.search</field>
            <field name="model">setu.stock.inventory</field>
            <field name="arch" type="xml">
                <search string="Inventario físico">
                    <field name="name" string="Referencia de inventario"/>
                    <field name="location_id"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="inventory_count_id"/>
                    <filter string="Validated" name="done" domain="[('state','=','done')]"/>
                    <filter string="Cancelled" name="cancel" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Ubicación" name="group_location" context="{'group_by':'location_id'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by':'partner_id'}"/>
                    <filter string="Conteo de inventario" name="group_inventory_count" context="{'group_by':'inventory_count_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by':'date'}"/>
                </search>
            </field>
        </record>

        <record id="setu_stock_inventory_act_window" model="ir.actions.act_window">
            <field name="name">Stock Inventory</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    There is no examples click here to add new Stock Inventory.
                </p>
            </field>
        </record>
    </data>
</odoo>