<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem name="Pending Progress" id="menu_setu_inventory_count_in_progress"
                  parent="setu_inventory_count_management.setu_inventory_count_root"
                  groups="setu_inventory_count_management.group_setu_inventory_count_manager"/>

        <record id="setu_stock_inventory_count_to_be_counted_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Count To Be Counted</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory.count</field>
            <field name="context">{'create':0}</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state','in',('Draft','In Progress'))]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    No hay conteos pendientes. Los nuevos conteos aparecerán aquí hasta completar sus sesiones.
                </p>
            </field>
        </record>

        <menuitem name="To Be Counted" id="inventory_count_to_be_counted_menu"
                  groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                  parent="setu_inventory_count_management.menu_setu_inventory_count_in_progress"
                  action="setu_stock_inventory_count_to_be_counted_act_window" sequence="2"/>


        <record id="setu_stock_inventory_count_to_be_approved_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Count To Be Approved</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory.count</field>
            <field name="context">{'create':0}</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state','=','To Be Approved')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    No hay conteos pendientes de aprobación. Los conteos completados aparecerán aquí para revisión del supervisor.
                </p>
            </field>
        </record>

        <menuitem name="To Be Approved"
                  id="inventory_count_to_be_approved_menu"
                  parent="setu_inventory_count_management.menu_setu_inventory_count_in_progress"
                  groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                  action="setu_stock_inventory_count_to_be_approved_act_window"
                  sequence="3"/>

        <record id="action_setu_stock_inventory_count_adjustment_act_window" model="ir.actions.act_window">
            <field name="name">Inventory Adjustments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">setu.stock.inventory</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('inventory_count_id','!=',False)]</field>
            <field name="context">{'create':0}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face" style="margin-top:250px;">
                    Los ajustes se generan desde conteos aprobados.
                </p>
                <p>
                    Revise las discrepancias aprobadas antes de aplicar el ajuste. El flujo controla ubicación, lote/serie, compañía y evita generar ajustes duplicados para el mismo conteo.
                </p>
            </field>
        </record>

        <menuitem name="Inventory Adjustments" id="inventory_count_adjustments_menu"
                  groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                  parent="setu_inventory_count_management.main_documents_menu"
                  action="action_setu_stock_inventory_count_adjustment_act_window"
                  sequence="11"/>
    </data>
</odoo>
