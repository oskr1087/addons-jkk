<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="setu_inventory_count_snapshot_line_list" model="ir.ui.view">
        <field name="name">setu.inventory.count.snapshot.line.list</field>
        <field name="model">setu.inventory.count.snapshot.line</field>
        <field name="arch" type="xml">
            <list string="Detalle del conteo" create="0" delete="0" decoration-success="status == 'matched'" decoration-danger="status in ('difference', 'unexpected')" decoration-warning="status in ('zero', 'duplicate')" decoration-muted="status == 'pending'">
                <field name="currency_id" column_invisible="True"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="expected_qty" sum="Esperado"/>
                <field name="counted_qty" sum="Contado"/>
                <field name="difference_display"/>
                <field name="unit_cost" widget="monetary" optional="hide" readonly="1"/>
                <field name="impact_value" widget="monetary" optional="show" decoration-danger="impact_value &lt; 0" decoration-success="impact_value &gt; 0"/>
                <field name="high_impact" optional="show"/>
                <field name="has_observation" string="Observación" optional="show"/>
                            <field name="status" widget="badge" decoration-success="status == 'matched'" decoration-danger="status in ('difference', 'unexpected')" decoration-warning="status in ('zero', 'duplicate')" decoration-muted="status == 'pending'"/>
                <field name="scan_count"/>
                <field name="last_session_id" optional="show"/>
                <field name="last_user_id" optional="show"/>
                <field name="last_scan_at" optional="show"/>
                            <field name="closed_as_zero" optional="hide" readonly="1"/>
                            <field name="recount_required" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="setu_inventory_count_snapshot_line_search" model="ir.ui.view">
        <field name="name">setu.inventory.count.snapshot.line.search</field>
        <field name="model">setu.inventory.count.snapshot.line</field>
        <field name="arch" type="xml">
            <search string="Detalle del conteo">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <filter name="pending" string="Pendientes" domain="[('status', '=', 'pending')]"/>
                <filter name="matched" string="Coinciden" domain="[('status', '=', 'matched')]"/>
                <filter name="differences" string="Divergencias" domain="[('status', 'in', ['difference', 'zero', 'unexpected', 'duplicate'])]"/>
                <filter name="unexpected" string="No previstos" domain="[('unexpected', '=', True)]"/>
                <filter name="duplicates" string="Duplicados" domain="[('duplicate', '=', True)]"/>
                <separator/>
                <filter name="group_product" string="Agrupar por producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_location" string="Agrupar por ubicación" context="{'group_by': 'location_id'}"/>
                <filter name="group_status" string="Agrupar por estado" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="setu_stock_inventory_count_snapshot_form_extension" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.snapshot.form.extension</field>
        <field name="model">setu.stock.inventory.count</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="setu_inventory_count_management.setu_stock_inventory_count_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']/button[@name='action_open_user_mistake_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']/button[@name='action_open_discrepancy_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<xpath expr="//header/button[@name='approve_all_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='reject_all_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='create_re_count']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='create_inventory_adj']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='complete_counting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- La aprobación base se oculta: el usuario solo ve acciones válidas para el estado actual. -->
            <xpath expr="//header/button[@name='approve_inventory_count']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='reject_inventory_count']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='create_session']" position="attributes">
                <attribute name="invisible">state != 'Draft' or count_id or not create_session_bool</attribute>
            </xpath>
            <xpath expr="//header/button[@name='cancel']" position="attributes">
                <attribute name="invisible">state != 'Draft' or count_id or not id</attribute>
            </xpath>

            <xpath expr="//header/button[@name='complete_counting']" position="before">
                <button name="action_sync_sessions_fast"
                        type="object"
                        string="Sincronizar sesiones"
                        icon="fa-refresh"
                        class="btn-secondary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state != 'In Progress' or count_id"/>
                <button name="action_mark_pending_as_zero" type="object" string="Pendientes = 0" invisible="1"/>
                <button name="action_accept_and_approve" type="object" string="Aceptar diferencias" invisible="1"/>
                <button name="action_approve_reviewed_count"
                        type="object"
                        string="Aprobar conteo"
                        icon="fa-check"
                        class="btn-primary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="not adjustment_ready or count_id"
                        confirm="Se aprobará el conteo global y solo se ajustarán las líneas marcadas «Aprobar para ajuste». ¿Desea continuar?"/>
                <button name="action_approve_without_differences" type="object" string="Aprobar" invisible="1"/>
                <button name="action_finalize_recount"
                        type="object"
                        string="Aprobar reconteo"
                        icon="fa-check-circle"
                        class="btn-primary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="not can_finalize_recount"
                        confirm="Se aprobará el reconteo y sus resultados se consolidarán en el conteo principal. El ajuste de inventario se realizará únicamente desde el conteo principal. ¿Desea continuar?"/>
                <button name="action_prepare_directed_recount" type="object" string="Generar reconteo" invisible="1"/>
                <button name="action_open_financial_adjustment_preview" type="object" string="Impacto económico" icon="fa-search" class="btn-secondary" groups="setu_inventory_count_management.group_setu_inventory_count_manager" invisible="not can_view_financial_preview"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="before">
                <div class="o_setu_count_control">
                    <field name="is_recount" invisible="1"/>
                    <field name="root_count_id" invisible="1"/>
                    <field name="review_pending_count" invisible="1"/>
                    <field name="adjustment_approved_count" invisible="1"/>
                    <field name="recount_review_count" invisible="1"/>
                    <field name="review_resolved_count" invisible="1"/>
                    <field name="can_finalize_recount" invisible="1"/>
                    <field name="recount_readiness_text" invisible="1"/>
                    <field name="can_review_actions" invisible="1"/>
                    <field name="can_send_to_recount" invisible="1"/>
                    <field name="can_manage_relocations" invisible="1"/>
                    <field name="can_view_financial_preview" invisible="1"/>

                    <div class="alert alert-info o_setu_recount_banner" invisible="not is_recount" role="status">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-refresh fa-lg" title="Reconteo"/>
                            <div>
                                <strong>RECONTEO</strong>
                                <div>
                                    Conteo principal:
                                    <field name="root_count_id" readonly="1" nolabel="1"/>
                                    <span class="ms-2">Este documento no genera ajustes de inventario; sus resultados se consolidan en el conteo principal.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_setu_next_action" invisible="state in ['Approved', 'Inventory Adjusted', 'Cancel'] and not is_recount">
                        <div class="o_setu_next_action_icon">
                            <i class="fa fa-compass" title="Siguiente acción"/>
                        </div>
                        <div class="flex-grow-1">
                            <strong><field name="next_action_title" readonly="1" nolabel="1"/></strong>
                            <span><field name="next_action_text" readonly="1" nolabel="1"/></span>
                        </div>
                        <button name="action_open_relocation_issues"
                                type="object"
                                string="Resolver ubicaciones"
                                icon="fa-exchange"
                                class="btn btn-primary ms-auto"
                                groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                                invisible="not can_manage_relocations"/>
                    </div>

                    <div class="o_setu_count_control_header">
                        <div>
                            <span class="o_setu_count_eyebrow">CONTROL DEL CONTEO</span>
                            <h2>Avance físico del inventario</h2>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mb-2" groups="setu_inventory_count_management.group_setu_inventory_count_admin" invisible="state not in ['In Progress', 'To Be Approved']">
                            <button name="action_admin_unlock_warehouse" type="object" string="Desbloquear almacén" class="btn btn-outline-danger" icon="fa-unlock" invisible="not warehouse_lock_active or state not in ['Draft', 'In Progress', 'To Be Approved']"/>
                            <button name="action_admin_lock_warehouse" type="object" string="Bloquear almacén" class="btn btn-outline-success" icon="fa-lock" invisible="warehouse_lock_active or state not in ['Draft', 'In Progress', 'To Be Approved']"/>
                        </div>
                        <!--
                            Un único estado visual del bloqueo.
                            warehouse_lock_active es la fuente de verdad del estado efectivo.
                            warehouse_lock_manual_disabled se conserva únicamente para impedir
                            que el bloqueo se reactive automáticamente después de una excepción
                            administrativa; el detalle de quién/cuándo queda en el chatter.
                        -->
                        <field name="warehouse_lock_manual_disabled" invisible="1"/>
                        <field name="warehouse_lock_started_at" invisible="1"/>

                        <div class="o_setu_count_lock" invisible="not warehouse_lock_active">
                            <i class="fa fa-lock" title="Almacén bloqueado"/>
                            <div>
                                <strong>Almacén bloqueado</strong>
                                <span>Movimientos restringidos durante el conteo.</span>
                            </div>
                        </div>

                        <div class="alert alert-success py-2 mb-0" invisible="warehouse_lock_active or state not in ['In Progress', 'To Be Approved']" role="status">
                            <i class="fa fa-unlock me-1" title="Almacén desbloqueado"/>
                            <strong>Almacén desbloqueado</strong>
                            <span class="ms-1">Los movimientos están permitidos temporalmente.</span>
                        </div>
                    </div>
                    <div class="o_setu_count_progress">
                        <div class="o_setu_count_progress_value">
                            <field name="progress_percent" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_setu_count_progress_track">
                            <field name="progress_percent" widget="progressbar" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <div class="o_setu_count_kpis o_setu_count_kpis_primary">
                        <div class="o_setu_count_kpi o_setu_kpi_counted">
                            <div class="o_setu_kpi_icon"><i class="fa fa-check-circle" title="Avance"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Procesados</span>
                                <strong>
                                    <field name="counted_item_count" readonly="1" nolabel="1"/>
                                    <small> de <field name="expected_item_count" readonly="1" nolabel="1"/></small>
                                </strong>
                                <small>Productos/lotes ya resueltos</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_pending">
                            <div class="o_setu_kpi_icon"><i class="fa fa-clock-o" title="Pendientes"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Pendientes</span>
                                <strong><field name="pending_item_count" readonly="1" nolabel="1"/></strong>
                                <small>Faltan por contar o declarar en cero</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_difference">
                            <div class="o_setu_kpi_icon"><i class="fa fa-exchange" title="Diferencias"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Para revisión</span>
                                <strong><field name="review_pending_count" readonly="1" nolabel="1"/></strong>
                                <small>Novedades pendientes de decisión</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_expected">
                            <div class="o_setu_kpi_icon"><i class="fa fa-check-square" title="Aprobados para ajuste"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Aprobados para ajuste</span>
                                <strong><field name="adjustment_approved_count" readonly="1" nolabel="1"/></strong>
                                <small>Diferencias confirmadas por el Controlador</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_duplicate">
                            <div class="o_setu_kpi_icon"><i class="fa fa-shield" title="Bloqueos"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Bloqueos para cerrar</span>
                                <strong><field name="blocking_issue_count" readonly="1" nolabel="1"/></strong>
                                <small>Sesiones, pendientes o duplicados</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_matched">
                            <div class="o_setu_kpi_icon"><i class="fa fa-map-marker" title="Avance de ubicaciones"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Avance de ubicaciones</span>
                                <strong><field name="location_global_progress_percent" readonly="1" nolabel="1"/> %</strong>
                                <small>
                                    <field name="location_done_count" readonly="1" nolabel="1"/>
                                    de <field name="location_total_count" readonly="1" nolabel="1"/> finalizadas
                                </small>
                            </div>
                        </div>
                        <button name="action_open_financial_adjustment_preview"
                                type="object"
                                class="o_setu_count_kpi o_setu_kpi_expected"
                                groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                                invisible="not can_view_financial_preview">
                            <div class="o_setu_kpi_icon"><i class="fa fa-money" title="Impacto económico"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Impacto económico</span>
                                <strong>Ver vista previa</strong>
                                <small>Disponible cuando existen líneas para ajustar</small>
                            </div>
                        </button>
                    </div>

                    <div class="o_setu_count_readiness o_setu_count_readiness_ok" invisible="not adjustment_ready">
                        <i class="fa fa-check-circle" title="Listo"/>
                        <div>
                            <strong>Listo para aprobar el conteo</strong>
                            <span><field name="adjustment_readiness_text" readonly="1" nolabel="1"/></span>
                        </div>
                    </div>
                    <div class="o_setu_count_readiness o_setu_count_readiness_wait" invisible="adjustment_ready">
                        <i class="fa fa-info-circle" title="Revisión pendiente"/>
                        <div>
                            <strong>Estado del proceso</strong>
                            <span><field name="adjustment_readiness_text" readonly="1" nolabel="1"/></span>
                        </div>
                    </div>

                    <div class="o_setu_count_meta">
                        <span invisible="not snapshot_ready" class="o_setu_meta_item">
                            <i class="fa fa-calendar-check-o" title="Información preparada"/>
                            Información preparada:
                            <field name="snapshot_date" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="not dashboard_last_update" class="o_setu_meta_item">
                            <i class="fa fa-clock-o" title="Última actualización"/>
                            Última lectura/actualización:
                            <field name="dashboard_last_update" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <field name="snapshot_ready" invisible="1"/>
                    <field name="location_global_progress_percent" invisible="1"/>
                    <field name="location_total_count" invisible="1"/>
                    <field name="location_done_count" invisible="1"/>

                <field name="observation_count" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="warehouse_lock_active" invisible="1"/>
                </div>
            </xpath>
<xpath expr="//sheet/div[h1]" position="replace">
                <div class="o_setu_count_identity">
                    <div class="o_setu_count_identity_icon">
                        <i class="fa fa-cube" title="Conteo"/>
                    </div>
                    <div>
                        <h1><field name="name" readonly="1" nolabel="1"/></h1>
                        <span>Resumen operativo del conteo</span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//sheet/group[1]" position="replace">
                <div class="o_setu_count_summary">
                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-map-marker" title="Ubicación"/>
                            <span>Ubicación</span>
                            <strong><field name="location_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-users" title="Sesiones"/>
                            <span>Sesiones</span>
                            <strong><field name="count_session_ids" readonly="1" nolabel="1"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-user" title="Aprobador"/>
                            <span>Aprobador</span>
                            <strong><field name="approver_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}" domain="[('id','in',approver_ids)]"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-tag" title="Tipo"/>
                            <span>Tipo</span>
                            <strong><field name="type" readonly="count_session_ids &gt; 0" nolabel="1"/></strong>
                        </div>
                    </div>

                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-building" title="Almacén"/>
                            <span>Almacén</span>
                            <strong><field name="warehouse_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-barcode" title="Modo de captura"/>
                            <span>Modo de captura</span>
                            <strong>
                                <field name="use_barcode_scanner" widget="boolean_toggle" readonly="state != 'Draft'" nolabel="1"/>
                                <span class="o_setu_capture_label">PDA / código de barras</span>
                            </strong>
                        </div>
                    </div>

                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-calendar" title="Fecha"/>
                            <span>Fecha</span>
                            <strong><field name="inventory_count_date" readonly="state != 'Draft'" nolabel="1"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-building-o" title="Compañía"/>
                            <span>Compañía</span>
                            <strong><field name="company_id" readonly="1" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                    </div>

                    <field name="approver_ids" invisible="1"/>
                    <field name="locations_ids" invisible="1"/>
                    <field name="create_count_bool" invisible="1"/>
                    <field name="planner_id" invisible="1"/>
                    <field name="count_id" invisible="1"/>
                </div>
            </xpath>
<xpath expr="//sheet/notebook" position="inside">
                <page string="Todos" name="snapshot_all" groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <field name="snapshot_line_ids" readonly="1">
                        <list create="0" delete="0" decoration-success="status == 'matched' and not has_observation" decoration-danger="status in ('difference', 'unexpected')" decoration-warning="status in ('zero', 'duplicate') or has_observation" decoration-muted="status == 'pending'">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_display"/>
                            <field name="status" widget="badge" decoration-success="status == 'matched'" decoration-danger="status in ('difference', 'unexpected')" decoration-warning="status in ('zero', 'duplicate')" decoration-muted="status == 'pending'"/>
                            <field name="has_observation" string="Tiene observaciones" optional="show"/>
                            <field name="observation_note" string="Observación" optional="show"/>
                            <field name="last_user_id" optional="show"/>
                            <field name="last_scan_at" optional="show"/>
                        </list>
                    </field>
                </page>

                <page string="Pendientes de conteo" name="snapshot_pending" groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <div class="alert alert-info" role="status">
                        <strong>Pendientes de escanear:</strong>
                        aquí se muestran únicamente productos, lotes o series esperados
                        que todavía no registran ninguna lectura en las sesiones del conteo.
                    </div>
                    <field name="snapshot_pending_line_ids" readonly="1">
                        <list create="0" delete="0" decoration-muted="1">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty" string="Cantidad esperada"/>
                            <field name="scan_count" string="Lecturas"/>
                            <field name="status" widget="badge" decoration-muted="1"/>
                        </list>
                    </field>
                </page>

                <page string="Para revisión" name="snapshot_to_resolve" groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <div class="alert alert-secondary" role="status"
                         invisible="state not in ['Approved', 'Inventory Adjusted', 'Cancel']">
                        <strong>Solo consulta.</strong>
                        Este conteo está cerrado; las decisiones registradas se conservan para auditoría.
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="state in ['Approved', 'Inventory Adjusted', 'Cancel']">
                        <strong>Bandeja única del Controlador.</strong>
                        Aquí se concentran únicamente las novedades que requieren control.
                        Seleccione líneas y decida si se resuelven sin ajuste, se recontarán,
                        se ajustarán o se descartarán.
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-2" invisible="not can_review_actions">
                        <button name="action_review_select_all"
                                type="object" string="Seleccionar todos"
                                icon="fa-check-square-o" class="btn-secondary"/>
                        <button name="action_review_unselect_all"
                                type="object" string="Quitar selección"
                                icon="fa-square-o" class="btn-secondary"/>
                        <span class="border-start mx-1"/>
                        <button name="action_review_selected_approve"
                                type="object" string="Resolver sin ajuste"
                                icon="fa-check-circle" class="btn-secondary"
                                confirm="Las líneas seleccionadas se considerarán revisadas y no generarán ajuste ni reconteo. ¿Desea continuar?"/>
                        <button name="action_review_selected_recount"
                                type="object" string="Mandar a reconteo"
                                icon="fa-refresh" class="btn-secondary"
                                invisible="not can_send_to_recount"/>
                        <button name="action_review_selected_adjust"
                                type="object" string="Aprobar para ajuste"
                                icon="fa-check" class="btn-primary"/>
                        <button name="action_review_selected_discard"
                                type="object" string="Descartar"
                                icon="fa-times" class="btn-secondary"/>
                    </div>
                    <field name="snapshot_to_resolve_line_ids" domain="[('review_required', '=', True)]">
                        <list create="0" delete="0" edit="1" editable="bottom" open_form_view="0"
                              decoration-danger="status in ('difference', 'unexpected')"
                              decoration-warning="status in ('zero', 'duplicate')">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="review_selected" string="Sel." readonly="not parent.can_review_actions"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="review_reason" string="Novedad" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="expected_qty" string="Sistema" readonly="1"/>
                            <field name="counted_qty" string="Físico" readonly="1"/>
                            <field name="difference_display" string="Diferencia" readonly="1"/>
                            <field name="review_decision" string="Decisión" readonly="1"/>
                            <field name="observation_note" string="Observación" optional="show" readonly="1"/>
                            <field name="status" widget="badge" optional="hide" readonly="1"
                                   decoration-danger="status in ('difference', 'unexpected')"
                                   decoration-warning="status in ('zero', 'duplicate')"/>
                            <field name="unit_cost" widget="monetary" optional="hide"/>
                            <field name="impact_value" widget="monetary" optional="hide" readonly="1"
                                   decoration-danger="impact_value &lt; 0"
                                   decoration-success="impact_value &gt; 0"/>
                            <field name="high_impact" optional="hide" readonly="1"/>
                            <field name="has_observation" string="Tiene observaciones" optional="hide" readonly="1"/>
                            <field name="unexpected" string="No previsto en ubicación" optional="hide" readonly="1"/>
                            <field name="closed_as_zero" optional="hide"/>
                            <field name="recount_required" optional="hide"/>
                            <field name="last_session_id" optional="hide" readonly="1"/>
                            <field name="last_user_id" optional="hide" readonly="1"/>
                            <field name="last_scan_at" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </page>


            </xpath>
        </field>
    </record>
</odoo>
