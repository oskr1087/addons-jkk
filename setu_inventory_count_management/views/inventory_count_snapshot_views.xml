<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="setu_inventory_count_snapshot_line_list" model="ir.ui.view">
        <field name="name">setu.inventory.count.snapshot.line.list</field>
        <field name="model">setu.inventory.count.snapshot.line</field>
        <field name="arch" type="xml">
            <list string="Detalle del conteo" create="0" delete="0"
                  decoration-success="status == 'matched'"
                  decoration-danger="status in ('difference', 'unexpected')"
                  decoration-warning="status in ('zero', 'duplicate')"
                  decoration-muted="status == 'pending'">
                <field name="currency_id" column_invisible="True"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="expected_qty" sum="Esperado"/>
                <field name="counted_qty" sum="Contado"/>
                <field name="difference_display"/>
                <field name="unit_cost" widget="monetary" optional="hide"/>
                <field name="impact_value" widget="monetary" optional="show"
                       decoration-danger="impact_value &lt; 0"
                       decoration-success="impact_value &gt; 0"/>
                <field name="high_impact" optional="show"/>
                <field name="status" widget="badge"
       decoration-success="status == 'matched'"
       decoration-danger="status in ('difference', 'unexpected')"
       decoration-warning="status in ('zero', 'duplicate')"
       decoration-muted="status == 'pending'"/>
                <field name="scan_count"/>
                <field name="last_session_id" optional="show"/>
                <field name="last_user_id" optional="show"/>
                <field name="last_scan_at" optional="show"/>
                            <field name="closed_as_zero" optional="hide"/>
                            <field name="recount_required" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="setu_inventory_count_snapshot_line_search" model="ir.ui.view">
        <field name="name">setu.inventory.count.snapshot.line.search</field>
        <field name="model">setu.inventory.count.snapshot.line</field>
        <field name="arch" type="xml">
            <search string="Detalle del conteo">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <filter name="pending" string="Pendientes" domain="[('status', '=', 'pending')]"/>
                <filter name="matched" string="Coinciden" domain="[('status', '=', 'matched')]"/>
                <filter name="differences" string="Divergencias" domain="[('status', 'in', ['difference', 'zero', 'unexpected', 'duplicate'])]"/>
                <filter name="unexpected" string="No previstos" domain="[('unexpected', '=', True)]"/>
                <filter name="duplicates" string="Duplicados" domain="[('duplicate', '=', True)]"/>
                <separator/>
                <filter name="group_product" string="Agrupar por producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_location" string="Agrupar por ubicación" context="{'group_by': 'location_id'}"/>
                <filter name="group_status" string="Agrupar por estado" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="setu_stock_inventory_count_snapshot_form_extension" model="ir.ui.view">
        <field name="name">setu.stock.inventory.count.snapshot.form.extension</field>
        <field name="model">setu.stock.inventory.count</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="setu_inventory_count_management.setu_stock_inventory_count_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']/button[@name='action_open_user_mistake_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']/button[@name='action_open_discrepancy_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<xpath expr="//header/button[@name='approve_all_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='reject_all_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='create_re_count']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='create_inventory_adj']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='complete_counting']" position="attributes">
                <attribute name="string">Enviar a revisión</attribute>
            </xpath>
            <xpath expr="//header/button[@name='approve_inventory_count']" position="attributes">
                <attribute name="string">Aprobar y generar ajuste</attribute>
                <attribute name="confirm">Se generará el ajuste únicamente con las diferencias aceptadas. ¿Desea continuar?</attribute>
            </xpath>

            <xpath expr="//header/button[@name='complete_counting']" position="before">
                <button name="action_mark_pending_as_zero"
                        type="object"
                        string="Pendientes = 0"
                        icon="fa-ban"
                        class="btn-secondary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state != 'In Progress' or pending_item_count == 0"
                        confirm="Los productos/lotes pendientes se considerarán NO ENCONTRADOS y su cantidad física será 0. ¿Desea continuar?"/>
                <button name="action_accept_adjustment_candidates"
                        type="object"
                        string="Aceptar diferencias"
                        icon="fa-check"
                        class="btn-secondary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state != 'To Be Approved' or adjustment_candidate_count == 0"
                        confirm="Las diferencias resueltas se aceptarán para el ajuste. ¿Desea continuar?"/>
                <button name="action_prepare_directed_recount"
                        type="object"
                        string="Reconteo de divergencias"
                        icon="fa-refresh"
                        class="btn-secondary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state != 'To Be Approved' or adjustment_candidate_count == 0"
                        confirm="Se enviarán las diferencias al flujo de reconteo. ¿Desea continuar?"/>
                <button name="action_open_financial_adjustment_preview"
                        type="object"
                        string="Vista previa del ajuste"
                        icon="fa-search"
                        class="btn-secondary"
                        groups="setu_inventory_count_management.group_setu_inventory_count_manager"
                        invisible="state != 'To Be Approved' or adjustment_candidate_count == 0"/>
            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="o_setu_count_control">
                    <div class="o_setu_count_control_header">
                        <div>
                            <span class="o_setu_count_eyebrow">CONTROL DEL CONTEO</span>
                            <h2>Avance físico del inventario</h2>
                        </div>
                        <div class="o_setu_count_lock" invisible="not warehouse_lock_active">
                            <i class="fa fa-lock" title="Almacén bloqueado"/>
                            <div>
                                <strong>Almacén bloqueado durante el conteo</strong>
                                <span invisible="not warehouse_lock_started_at">
                                    Bloqueado desde:
                                    <field name="warehouse_lock_started_at" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="o_setu_count_progress">
                        <div class="o_setu_count_progress_value">
                            <field name="progress_percent" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_setu_count_progress_track">
                            <field name="progress_percent" widget="progressbar" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <div class="o_setu_count_kpis o_setu_count_kpis_primary">
                        <div class="o_setu_count_kpi o_setu_kpi_counted">
                            <div class="o_setu_kpi_icon"><i class="fa fa-check-circle" title="Avance"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Procesados</span>
                                <strong>
                                    <field name="counted_item_count" readonly="1" nolabel="1"/>
                                    <small> de <field name="expected_item_count" readonly="1" nolabel="1"/></small>
                                </strong>
                                <small>Productos/lotes ya resueltos</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_pending">
                            <div class="o_setu_kpi_icon"><i class="fa fa-clock-o" title="Pendientes"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Pendientes</span>
                                <strong><field name="pending_item_count" readonly="1" nolabel="1"/></strong>
                                <small>Faltan por contar o declarar en cero</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_difference">
                            <div class="o_setu_kpi_icon"><i class="fa fa-exchange" title="Diferencias"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Diferencias a revisar</span>
                                <strong><field name="adjustment_candidate_count" readonly="1" nolabel="1"/></strong>
                                <small>Faltantes, sobrantes o no previstos</small>
                            </div>
                        </div>
                        <div class="o_setu_count_kpi o_setu_kpi_duplicate">
                            <div class="o_setu_kpi_icon"><i class="fa fa-shield" title="Bloqueos"/></div>
                            <div class="o_setu_kpi_body">
                                <span>Bloqueos para cerrar</span>
                                <strong><field name="blocking_issue_count" readonly="1" nolabel="1"/></strong>
                                <small>Sesiones, pendientes o duplicados</small>
                            </div>
                        </div>
                    </div>

                    <div class="o_setu_count_readiness o_setu_count_readiness_ok"
                         invisible="not adjustment_ready">
                        <i class="fa fa-check-circle" title="Listo"/>
                        <div>
                            <strong>Listo para generar el ajuste</strong>
                            <span><field name="adjustment_readiness_text" readonly="1" nolabel="1"/></span>
                        </div>
                    </div>
                    <div class="o_setu_count_readiness o_setu_count_readiness_wait"
                         invisible="adjustment_ready">
                        <i class="fa fa-info-circle" title="Revisión pendiente"/>
                        <div>
                            <strong>Estado previo al ajuste</strong>
                            <span><field name="adjustment_readiness_text" readonly="1" nolabel="1"/></span>
                        </div>
                    </div>

                    <div class="o_setu_count_financial">
                        <div class="o_setu_count_financial_header">
                            <div>
                                <span class="o_setu_count_eyebrow">IMPACTO ECONÓMICO</span>
                                <strong>Estimación sobre diferencias resueltas</strong>
                            </div>
                            <span class="o_setu_financial_note">
                                <i class="fa fa-info-circle" title="Información"/>
                                Referencial: no modifica costos ni valoración contable.
                            </span>
                        </div>
                        <div class="o_setu_count_kpis o_setu_count_kpis_financial">
                            <div class="o_setu_count_kpi o_setu_kpi_expected">
                                <div class="o_setu_kpi_icon"><i class="fa fa-money" title="Valor esperado"/></div>
                                <div class="o_setu_kpi_body">
                                    <span>Valor base del inventario</span>
                                    <strong><field name="expected_value" widget="monetary" readonly="1" nolabel="1"/></strong>
                                    <small>Según costo congelado al iniciar</small>
                                </div>
                            </div>
                            <div class="o_setu_count_kpi o_setu_kpi_difference">
                                <div class="o_setu_kpi_icon"><i class="fa fa-arrow-down" title="Pérdida estimada"/></div>
                                <div class="o_setu_kpi_body">
                                    <span>Faltantes valorizados</span>
                                    <strong><field name="shortage_value" widget="monetary" readonly="1" nolabel="1"/></strong>
                                    <small>Disminución estimada</small>
                                </div>
                            </div>
                            <div class="o_setu_count_kpi o_setu_kpi_matched">
                                <div class="o_setu_kpi_icon"><i class="fa fa-arrow-up" title="Sobrante estimado"/></div>
                                <div class="o_setu_kpi_body">
                                    <span>Sobrantes valorizados</span>
                                    <strong><field name="surplus_value" widget="monetary" readonly="1" nolabel="1"/></strong>
                                    <small>Incremento estimado</small>
                                </div>
                            </div>
                            <div class="o_setu_count_kpi o_setu_kpi_unexpected">
                                <div class="o_setu_kpi_icon"><i class="fa fa-balance-scale" title="Impacto neto"/></div>
                                <div class="o_setu_kpi_body">
                                    <span>Impacto neto estimado</span>
                                    <strong><field name="net_adjustment_value" widget="monetary" readonly="1" nolabel="1"/></strong>
                                    <small>Faltantes + sobrantes</small>
                                </div>
                            </div>
                        </div>
                        <div class="o_setu_high_impact_alert" invisible="high_impact_item_count == 0">
                            <i class="fa fa-exclamation-triangle" title="Alto impacto"/>
                            <span>
                                <strong><field name="high_impact_item_count" readonly="1" nolabel="1"/></strong>
                                divergencia(s) superan el umbral económico y deben revisarse primero.
                            </span>
                        </div>
                    </div>

                    <div class="o_setu_count_meta">
                        <span invisible="not snapshot_ready" class="o_setu_meta_item">
                            <i class="fa fa-calendar-check-o" title="Información preparada"/>
                            Información preparada:
                            <field name="snapshot_date" readonly="1" nolabel="1"/>
                        </span>
                        <span invisible="not dashboard_last_update" class="o_setu_meta_item">
                            <i class="fa fa-clock-o" title="Última actualización"/>
                            Última lectura/actualización:
                            <field name="dashboard_last_update" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <field name="snapshot_ready" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="warehouse_lock_active" invisible="1"/>
                </div>
            </xpath>
<xpath expr="//sheet/div[h1]" position="replace">
                <div class="o_setu_count_identity">
                    <div class="o_setu_count_identity_icon">
                        <i class="fa fa-cube" title="Conteo"/>
                    </div>
                    <div>
                        <h1><field name="name" readonly="1" nolabel="1"/></h1>
                        <span>Resumen operativo del conteo</span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//sheet/group[1]" position="replace">
                <div class="o_setu_count_summary">
                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-map-marker" title="Ubicación"/>
                            <span>Ubicación</span>
                            <strong><field name="location_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-users" title="Sesiones"/>
                            <span>Sesiones</span>
                            <strong><field name="count_session_ids" readonly="1" nolabel="1"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-user" title="Aprobador"/>
                            <span>Aprobador</span>
                            <strong><field name="approver_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}" domain="[('id','in',approver_ids)]"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-tag" title="Tipo"/>
                            <span>Tipo</span>
                            <strong><field name="type" readonly="count_session_ids &gt; 0" nolabel="1"/></strong>
                        </div>
                    </div>

                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-building" title="Almacén"/>
                            <span>Almacén</span>
                            <strong><field name="warehouse_id" readonly="state != 'Draft'" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-barcode" title="Modo de captura"/>
                            <span>Modo de captura</span>
                            <strong>
                                <field name="use_barcode_scanner" widget="boolean_toggle" readonly="state != 'Draft'" nolabel="1"/>
                                <span class="o_setu_capture_label">PDA / código de barras</span>
                            </strong>
                        </div>
                    </div>

                    <div class="o_setu_summary_col">
                        <div class="o_setu_summary_row">
                            <i class="fa fa-calendar" title="Fecha"/>
                            <span>Fecha</span>
                            <strong><field name="inventory_count_date" readonly="state != 'Draft'" nolabel="1"/></strong>
                        </div>
                        <div class="o_setu_summary_row">
                            <i class="fa fa-building-o" title="Compañía"/>
                            <span>Compañía</span>
                            <strong><field name="company_id" readonly="1" nolabel="1" options="{'no_create': True, 'no_open':True}"/></strong>
                        </div>
                    </div>

                    <field name="approver_ids" invisible="1"/>
                    <field name="locations_ids" invisible="1"/>
                    <field name="create_count_bool" invisible="1"/>
                    <field name="planner_id" invisible="1"/>
                    <field name="count_id" invisible="1"/>
                </div>
            </xpath>
<xpath expr="//sheet/notebook" position="inside">
                <page string="Todos" name="snapshot_all"
                      groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <field name="snapshot_line_ids" readonly="1">
                        <list create="0" delete="0"
                              decoration-success="status == 'matched'"
                              decoration-danger="status in ('difference', 'unexpected')"
                              decoration-warning="status in ('zero', 'duplicate')"
                              decoration-muted="status == 'pending'">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_display"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'matched'"
                                   decoration-danger="status in ('difference', 'unexpected')"
                                   decoration-warning="status in ('zero', 'duplicate')"
                                   decoration-muted="status == 'pending'"/>
                            <field name="last_user_id" optional="show"/>
                            <field name="last_scan_at" optional="show"/>
                        </list>
                    </field>
                </page>

                <page string="Pendientes" name="snapshot_pending"
                      groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <field name="snapshot_line_ids" readonly="1" domain="[('status', '=', 'pending')]">
                        <list create="0" delete="0" decoration-muted="1">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty"/>
                            <field name="status" widget="badge" decoration-muted="1"/>
                        </list>
                    </field>
                </page>

                <page string="Por resolver" name="snapshot_to_resolve"
                      groups="setu_inventory_count_management.group_setu_inventory_count_manager">
                    <field name="snapshot_line_ids" readonly="1"
                           domain="[('status', 'in', ['difference', 'zero', 'unexpected', 'duplicate'])]">
                        <list create="0" delete="0"
                              decoration-danger="status in ('difference', 'unexpected')"
                              decoration-warning="status in ('zero', 'duplicate')">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_display"/>
                            <field name="unit_cost" widget="monetary"/>
                            <field name="impact_value" widget="monetary"
                                   decoration-danger="impact_value &lt; 0"
                                   decoration-success="impact_value &gt; 0"/>
                            <field name="high_impact"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status in ('difference', 'unexpected')"
                                   decoration-warning="status in ('zero', 'duplicate')"/>
                            <field name="closed_as_zero" optional="show"/>
                            <field name="recount_required" optional="show"/>
                            <field name="last_session_id" optional="show"/>
                            <field name="last_user_id" optional="show"/>
                            <field name="last_scan_at" optional="show"/>
                        </list>
                    </field>
                </page>

                <page string="Sesiones" name="snapshot_sessions">
                    <field name="session_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="location_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
