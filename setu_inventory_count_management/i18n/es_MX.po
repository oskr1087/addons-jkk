#. module: setu_inventory_count_management
#: model_terms:ir.ui.view,arch_db:setu_inventory_count_management.inventory_count_session_form_view
msgid ""
"<strong>1.</strong>\n"
"                                    Scan the location first\n"
"                                    <br/>\n"
"                                    <strong>2.</strong>\n"
"                                    If \"No Tracking\" type product then directly scan the product's Barcode.\n"
"                                    <br/>\n"
"                                        If \"Serial\" type product then scan Barcode of the\n"
"                                    serial number\n"
"                                    <br/>\n"
"                                        If \"Lot\" type product then scan Barcode of lot and\n"
"                                    then scan product's Barcode, if you want change the lot\n"
"                                    <br/>\n"
"                                        then scan again the Barcode of lot and rest will be\n"
"                                    the same.\n"
"                                    <br/>\n"
"                                    <strong>3.</strong>\n"
"                                    Change the location every time if you start to scan the product of different\n"
"                                    location."
msgstr ""
"<strong>1.</strong>\n"
"                                    Escanee primero la ubicación\n"
"                                    <br/>\n"
"                                    <strong>2.</strong>\n"
"                                    Si el producto es de tipo \"Sin seguimiento\", escanee directamente su código de barras.\n"
"                                    <br/>\n"
"                                        Si el producto es de tipo \"Serie\", escanee el código de barras del\n"
"                                    número de serie\n"
"                                    <br/>\n"
"                                        Si el producto es de tipo \"Lote\", escanee el código de barras del lote y\n"
"                                    luego el código de barras del producto; si desea cambiar el lote,\n"
"                                    <br/>\n"
"                                        vuelva a escanear el código de barras del lote y lo demás será\n"
"                                    igual.\n"
"                                    <br/>\n"
"                                    <strong>3.</strong>\n"
"                                    Cambie la ubicación cada vez que comience a escanear productos de otra\n"
"                                    ubicación."

