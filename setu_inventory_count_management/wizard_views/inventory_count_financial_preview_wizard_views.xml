<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inventory_count_financial_preview_wizard_form" model="ir.ui.view">
        <field name="name">setu.inventory.count.financial.preview.wizard.form</field>
        <field name="model">setu.inventory.count.financial.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Impacto económico del ajuste">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Información referencial calculada sobre la vista previa del ajuste.
                        No modifica costos ni valoración contable.
                    </div>
                    <group col="4">
                        <field name="currency_id" invisible="1"/>
                        <field name="expected_value" widget="monetary"/>
                        <field name="shortage_value" widget="monetary"/>
                        <field name="surplus_value" widget="monetary"/>
                        <field name="net_adjustment_value" widget="monetary"/>
                        <field name="adjustment_candidate_count"/>
                        <field name="high_impact_item_count"/>
                    </group>
                    <separator string="Líneas que formarían parte del ajuste"/>
                    <field name="preview_line_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="expected_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_qty"/>
                            <field name="unit_cost"/>
                            <field name="impact_value"/>
                            <field name="status" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_open_lines" type="object"
                            string="Abrir líneas" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
