<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Valuation/stock quant list used in reporting -->
    <record id="view_stock_quant_valuation_warehouse_list" model="ir.ui.view">
        <field name="name">stock.quant.valuation.warehouse.list</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="warehouse_id"
                       string="Almacén"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!-- Editable quant/location report variant -->
    <record id="view_stock_quant_valuation_warehouse_editable_list" model="ir.ui.view">
        <field name="name">stock.quant.valuation.warehouse.editable.list</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="warehouse_id"
                       string="Almacén"
                       optional="show"
                       readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_valuation_warehouse_search" model="ir.ui.view">
        <field name="name">stock.quant.valuation.warehouse.search</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <filter name="locationgroup" position="after">
                <filter string="Almacén"
                        name="warehousegroup"
                        context="{'group_by': 'warehouse_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_stock_quant_valuation_warehouse_pivot" model="ir.ui.view">
        <field name="name">stock.quant.valuation.warehouse.pivot</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_pivot"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="warehouse_id" type="row"/>
            </field>
        </field>
    </record>
</odoo>
