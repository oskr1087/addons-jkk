<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extender vista formulario de stock.move.line -->
        <record id="stock_move_line_form_view_auto_lot" model="ir.ui.view">
            <field name="name">stock.move.line.form.auto.lot</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='quantity']" position="after">
                    <field name="lot_name" invisible="0"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>