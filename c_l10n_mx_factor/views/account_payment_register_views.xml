<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_factor" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.factor</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_mx_edi_payment_method_id']" position="after">
                <field name="l10n_mx_factor" invisible="country_code != 'MX'"/>
                <field name="l10n_mx_factor_factor_id"
                       invisible="not l10n_mx_factor"
                       required="l10n_mx_factor"
                       options="{'no_create': True}"/>
                <field name="l10n_mx_factor_scheme"
                       invisible="not l10n_mx_factor"/>
                <div class="alert alert-info" role="alert" colspan="2"
                     invisible="not l10n_mx_factor">
                    El complemento de pago se timbrará con el <b>factor</b> como receptor
                    (no tu cliente).
                </div>
                <div class="alert alert-warning" role="alert" colspan="2"
                     invisible="not l10n_mx_factor_warning">
                    <field name="l10n_mx_factor_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
