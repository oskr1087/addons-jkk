<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_mrporder_jkk" inherit_id="mrp.report_mrporder">

        <!-- Reemplazar el contenido de la página -->
        <xpath expr="//div[@class='page']" position="replace">

            <div class="page">

                <!-- ========================= -->
                <!-- ENCABEZADO -->
                <!-- ========================= -->

                <div class="row">

                    <div class="col-7">
                        <h2>
                            Orden de Fabricación:
                            <span t-field="o.name"/>
                        </h2>
                    </div>

                    <div class="col-5 text-end">
                        <span t-field="o.name" t-options="{
                                'widget':'barcode',
                                'width':600,
                                'height':100,
                                'img_style':'width:320px;height:55px'
                              }"/>
                    </div>

                </div>

                <hr/>

                <!-- ========================= -->
                <!-- INFORMACIÓN GENERAL -->
                <!-- ========================= -->

                <div class="row">

                    <div class="col-6">

                        <table class="table table-sm table-borderless">

                            <tr>
                                <td width="45%">
                                    <strong>Fecha vencimiento</strong>
                                </td>

                                <td>
                                    <span t-field="o.date_deadline"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Código Cliente</strong>
                                </td>

                                <td>
                                    <span t-field="o.customer_code"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Pedido Cliente</strong>
                                </td>

                                <td>
                                    <span t-field="o.sale_reference"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Artículo</strong>
                                </td>

                                <td>
                                    <span t-field="o.product_id.default_code"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Descripción</strong>
                                </td>

                                <td>
                                    <span t-field="o.product_id.display_name"/>
                                </td>
                            </tr>

                        </table>

                    </div>

                    <div class="col-6">

                        <table class="table table-sm table-borderless">

                            <tr>
                                <td width="45%">
                                    <strong>Diseño No</strong>
                                </td>

                                <td>
                                    <span t-field="o.design_no"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Tipo</strong>
                                </td>

                                <td>
                                    <span t-field="o.production_type"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Estado</strong>
                                </td>

                                <td>
                                    <span t-field="o.state"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Origen</strong>
                                </td>

                                <td>
                                    <span t-field="o.origin_type"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Tipo Orden</strong>
                                </td>

                                <td>
                                    <span t-field="o.order_type"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Cliente</strong>
                                </td>

                                <td>
                                    <span t-field="o.customer_name"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Lista Materiales</strong>
                                </td>

                                <td>
                                    <span t-field="o.bom_reference"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Cantidad</strong>
                                </td>

                                <td>
                                    <span t-field="o.product_qty"/>
                                    <span t-field="o.product_uom_id"/>
                                </td>
                            </tr>

                        </table>

                    </div>

                </div>

                <!-- ========================= -->
                <!-- COMPONENTES -->
                <!-- ========================= -->

                <t t-call="mrp.report_mrp_production_components"/>

            </div>

        </xpath>

    </template>

</odoo>