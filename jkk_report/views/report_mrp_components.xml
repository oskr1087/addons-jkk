<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="report_mrp_production_components_jkk" inherit_id="mrp.report_mrp_production_components">

    <!-- Reemplazar completamente la tabla -->
    <xpath expr="//table" position="replace">

      <table class="table table-sm table-bordered">

        <thead>

          <tr class="table-secondary">

            <th style="width:5%;" class="text-center">
                            #
            </th>

            <th style="width:18%;">
                            Número de artículo
            </th>

            <th>
                            Descripción
            </th>

            <th style="width:8%;" class="text-center">
                            UM
            </th>

            <th style="width:15%;" class="text-end">
                            Cantidad
            </th>

            <th style="width:10%;" class="text-center">
                            Código almacén
            </th>

          </tr>

        </thead>

        <tbody>

          <t t-set="i" t-value="1"/>

          <t t-foreach="o.move_raw_ids.sorted(key=lambda m: m.sequence)" t-as="move">

            <tr>

              <!-- Número -->

              <td class="text-center">

                <span t-esc="i"/>

              </td>

              <!-- Código -->

              <td>

                <span t-field="move.product_id.default_code"/>

              </td>

              <!-- Descripción -->

              <td>

                <span t-field="move.product_id.display_name"/>

              </td>

              <!-- UM -->

              <td class="text-center">

                <span t-field="move.product_uom"/>

              </td>

              <!-- Cantidad -->

              <td class="text-end">

                <span t-field="move.product_uom_qty"/>

              </td>

              <!-- Código almacén -->

              <td class="text-center">

                <span t-esc="move.location_id.id"/>

              </td>

            </tr>

            <t t-set="i" t-value="i+1"/>

          </t>

        </tbody>

      </table>

    </xpath>

  </template>

</odoo>