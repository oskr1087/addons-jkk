<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Fecha teórica de pago -->

    <record id="purchase_order_form_jkk" model="ir.ui.view">

        <field name="name">purchase.order.form.jkk</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="estimated_payment_date" readonly="1"/>
            </xpath>
            <!-- Fecha por línea -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="date_planned" string="Fecha Entrega"/>
            </xpath>

        </field>

    </record>

</odoo>