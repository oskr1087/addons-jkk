<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_lot_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.lot.wizard.form</field>
        <field name="model">mrp.production.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar lotes">
                <group>
                    <field name="production_id"/>
                    <field name="workcenter_id"/>
                    <field name="lot_count" autofocus="autofocus"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
