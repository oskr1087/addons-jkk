<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_lot_distribution_tree_view" model="ir.ui.view">
        <field name="name">mrp.production.lot.distribution.tree</field>
        <field name="model">mrp.production.lot.distribution</field>
        <field name="arch" type="xml">
            <list>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="quantity_to_produce" sum="Total a producir"/>
                <field name="total_quantity" sum="Total distribuido"/>
                <field name="difference_quantity"/>
                <field name="is_valid"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="mrp_production_lot_distribution_form_view" model="ir.ui.view">
        <field name="name">mrp.production.lot.distribution.form</field>
        <field name="model">mrp.production.lot.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribución de lotes">
                <header>
                    <button name="action_validate_distribution"
                            type="object"
                            string="Validar distribución"
                            class="btn-primary"
                            invisible="state in ('done', 'cancel')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="quantity_to_produce" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_quantity" readonly="1"/>
                            <field name="difference_quantity" readonly="1"/>
                            <field name="is_valid" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lotes">
                            <field name="line_ids"
                                   readonly="state in ('done', 'cancel')"
                                   context="{'default_product_id': product_id}">
                                <list editable="bottom">
                                    <field name="lot_id"
                                           domain="[('product_id', '=', product_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="quantity" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_production_lot_distribution_action" model="ir.actions.act_window">
        <field name="name">Distribuciones de lotes</field>
        <field name="res_model">mrp.production.lot.distribution</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="mrp_production_lot_distribution_menu"
              name="Lot Distributions"
              parent="mrp.menu_mrp_reporting"
              action="mrp_production_lot_distribution_action"
              sequence="90"/>

</odoo>
