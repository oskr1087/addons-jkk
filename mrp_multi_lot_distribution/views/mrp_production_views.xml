<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_multi_lot_distribution" model="ir.ui.view">
        <field name="name">mrp.production.form.multi.lot.distribution</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Lotes" name="lot_distribution" invisible="product_tracking != 'lot'">
                    <field name="lot_distribution_id" invisible="1"/>
                    <field name="lot_distribution_valid" invisible="1"/>
                    <field name="lot_distribution_total_qty" invisible="1"/>
                    <field name="lot_distribution_difference" invisible="1"/>
                    <field name="product_uom_id" invisible="1"/>

                    <field name="lot_distribution_line_ids"
                           readonly="state in ('done', 'cancel')">
                        <list editable="bottom">
                            <field name="lot_id"
                                   context="{'default_product_id': product_id}"
                                   domain="[('product_id', '=', product_id), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="quantity" sum="Total"/>
                        </list>
                    </field>

                    <div class="text-muted">
                        Distribuido:
                        <field name="lot_distribution_total_qty" readonly="1" nolabel="1"/>
                        /
                        A producir:
                        <field name="qty_producing" readonly="1" nolabel="1"/>
                        -
                        Diferencia:
                        <field name="lot_distribution_difference" readonly="1" nolabel="1"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
