<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="action_report_mrp_reconditioning" model="ir.actions.report">
<field name="name">Orden de Reacondicionamiento</field><field name="model">mrp.reconditioning</field><field name="report_type">qweb-pdf</field>
<field name="report_name">mrp_reconditioning.report_reconditioning_document</field><field name="report_file">mrp_reconditioning.report_reconditioning_document</field>
<field name="binding_model_id" ref="model_mrp_reconditioning"/><field name="binding_type">report</field><field name="print_report_name">'Reacondicionamiento - %s' % object.name</field></record>
<template id="report_reconditioning_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page">
<h2>Orden de Reacondicionamiento <span t-field="o.name"/></h2>
<div class="row mt-3 mb-3"><div class="col-6"><strong>Producto:</strong> <span t-field="o.product_id"/><br/><strong>Lote/Serie:</strong> <span t-field="o.lot_id"/><br/><strong>Cantidad:</strong> <span t-field="o.quantity"/> <span t-field="o.product_uom_id"/></div>
<div class="col-6"><strong>Estado:</strong> <span t-field="o.state"/><br/><strong>Ubicación origen:</strong> <span t-field="o.location_id"/><br/><strong>OF:</strong> <span t-if="o.production_id" t-field="o.production_id"/><span t-else="">Sin generar</span></div></div>
<h4>Consumos</h4><table class="table table-sm table-bordered"><thead><tr><th>Tipo</th><th>Producto</th><th>Lote/Serie</th><th>Ubicación</th><th class="text-end">Cantidad</th><th>Unidad</th></tr></thead><tbody>
<t t-if="o.production_id"><t t-foreach="o.production_id.move_raw_ids" t-as="move"><tr><td><span t-if="move.is_reconditioning_return_component">Producto a reacondicionar</span><span t-else="">Componente adicional</span></td><td><span t-field="move.product_id"/></td>
<td><t t-set="lots" t-value="move.move_line_ids.mapped('lot_id')"/><span t-if="lots" t-esc="', '.join(lots.mapped('name'))"/><span t-elif="move.is_reconditioning_return_component" t-field="o.lot_id"/><span t-else="">-</span></td>
<td><span t-field="move.location_id"/></td><td class="text-end"><span t-if="o.production_id.state == 'done'" t-esc="'%.4f' % move.quantity"/><span t-else="" t-esc="'%.4f' % move.product_uom_qty"/></td><td><span t-field="move.product_uom"/></td></tr></t></t>
<t t-else=""><tr><td>Producto a reacondicionar</td><td><span t-field="o.product_id"/></td><td><span t-field="o.lot_id"/></td><td><span t-field="o.location_id"/></td><td class="text-end"><span t-field="o.quantity"/></td><td><span t-field="o.product_uom_id"/></td></tr>
<t t-foreach="o.component_line_ids" t-as="line"><tr><td>Componente adicional</td><td><span t-field="line.product_id"/></td><td>-</td><td><span t-field="line.location_id"/></td><td class="text-end"><span t-field="line.quantity"/></td><td><span t-field="line.product_uom_id"/></td></tr></t></t></tbody></table>
<t t-if="o.production_id"><h4 class="mt-4">Resultado</h4><table class="table table-sm table-bordered"><thead><tr><th>Producto obtenido</th><th>Lote/Serie</th><th>Ubicación destino</th><th class="text-end">Cantidad</th><th>Unidad</th></tr></thead><tbody><tr>
<td><span t-field="o.production_id.product_id"/></td><td><span t-field="o.lot_id"/></td><td><span t-field="o.production_id.location_dest_id"/></td><td class="text-end"><span t-if="o.production_id.state == 'done'" t-field="o.production_id.qty_produced"/><span t-else="" t-field="o.production_id.product_qty"/></td><td><span t-field="o.production_id.product_uom_id"/></td></tr></tbody></table>
<div class="row mt-3"><div class="col-6"><strong>Inicio OF:</strong> <span t-if="o.production_id.date_start" t-field="o.production_id.date_start"/></div><div class="col-6"><strong>Finalización OF:</strong> <span t-if="o.production_id.date_finished" t-field="o.production_id.date_finished"/></div></div><div><strong>Responsable:</strong> <span t-field="o.production_id.user_id"/></div></t>
<div class="row mt-5"><div class="col-6 text-center">______________________________<br/>Responsable de reacondicionamiento</div><div class="col-6 text-center">______________________________<br/>Recibido / Verificado</div></div>
</div></t></t></t></template></odoo>