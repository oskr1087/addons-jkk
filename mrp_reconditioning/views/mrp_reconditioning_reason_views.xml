<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_reconditioning_reason_list" model="ir.ui.view">
        <field name="name">mrp.reconditioning.reason.list</field>
        <field name="model">mrp.reconditioning.reason</field>
        <field name="arch" type="xml">
            <list string="Motivos de reacondicionamiento" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_reconditioning_reason" model="ir.actions.act_window">
        <field name="name">Motivos de reacondicionamiento</field>
        <field name="res_model">mrp.reconditioning.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
