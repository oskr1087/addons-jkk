<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_mrp_production_form_reconditioning_link" model="ir.ui.view">
 <field name="name">mrp.production.form.reconditioning.link</field><field name="model">mrp.production</field>
 <field name="inherit_id" ref="mrp.mrp_production_form_view"/><field name="arch" type="xml">
  <xpath expr="//sheet" position="inside"><field name="is_reconditioning" invisible="1"/><field name="reconditioning_id" invisible="1"/>
   <widget name="web_ribbon" text="REACONDICIONAMIENTO" bg_color="text-bg-info" invisible="not is_reconditioning"/></xpath>
  <xpath expr="//div[@name='button_box']" position="inside">
   <button name="action_open_reconditioning" type="object" class="oe_stat_button" icon="fa-refresh" invisible="not reconditioning_id">
    <field name="reconditioning_id" widget="statinfo" string="Reacondicionamiento"/></button>
  </xpath>
 </field>
</record></odoo>