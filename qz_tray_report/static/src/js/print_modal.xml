<templates xml:space="preserve">

    <t t-name="ControlPanelView_inherit" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel')]" position="after">
            <div class="modal fade zplReportModal" id="zplReportModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-body">
                            <div class="d-flex justify-content-between">
                                <div class="h6" id="zplReportModalHeading">Imprimir</div>
                                <span>
                                    <button class="btn btn-outline-warning mx-3" id="QZConnectionBtnR" title="Connect QZ tray" style="display: inline;">
                                        <i class="fa fa-power-off"></i>
                                        <i class="fa fa-print"></i>
                                    </button>
                                    <span class="btn btn-outline-primary mx-3" id="QZListPrinterBtnR" title="List all Printer" style="display: none;">
                                        <i class="fa fa-refresh"></i>
                                        <i class="fa fa-print"></i>
                                    </span>
                                    <span class="btn btn-outline-primary mx-3" id="zplViewerModalPrintBtnR" title="Print ZPL label" style="display: none;">
                                        <i class="fa fa-print"></i>
                                        <i class="fa fa-arrow-right "></i>
                                    </span>
                                    <button type="button" class="btn btn-close btn-danger" id="zplReportModalCloseIco" aria-label="Close"></button>
                                </span>
                            </div>
                            <div id="QZPrinterAreaR" class="d-flex py-2 align-items-center d-none pt-4">
                                <label id="QZPrinterLabelAreaR" class="px-2">Seleccione una impresora:</label>
                                <select id="QZPrinterListAreaR" class="col">
                                    <option value="">-- Seleccionar impresora --</option>
                                </select>
                            </div>
                            <hr/>
                            <div class="text-center p-2 h4" id="zplReport_loading" style="display: none;"></div>
                            <div class="d-flex justify-content-center pt-4">
                                <a class="mx-2 btn btn-outline-primary pt-2 w-100" id="zplReportDownload" href="">
                                    <i class="fa fa-download" aria-hidden="true"></i> Descargar
                                </a>
                                <div class="text-center btn btn-outline-primary mx-2 w-100" id="zplReportModalCloseBtn">
                                    Cerrar
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
